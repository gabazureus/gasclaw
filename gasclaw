cmd_poc() { # POCs automáticas, só no dev: cria fixtures, mede e sai ≠ 0 se algum critério falhar
  local id="${1:-}" step="${2:-}" r trace=""
  [ "$TARGET" = dev ] || die "POCs run on dev only"
  printf '%s' "$id" | grep -qE '^p[0-9]+$' || die "usage: ./gasclaw poc <id> [step]  (e.g. ./gasclaw poc p6)"
  [ -z "$step" ] || printf '%s' "$step" | grep -qE '^[a-z0-9]+$' || die "invalid step: $step"
  lock_dev # a POC inteira (deploy + medições) sem push de outra pista no meio
  local hook
  hook=$(ls poc/"$id"-*/pc.sh 2>/dev/null | head -1 || true)
  if [ -n "$hook" ]; then # POC com etapas no PC (clasp): pc.sh (tudo) ou <etapa>.sh orquestra e decide o exit
    # subshell + die: no bash 3.2, erro implícito do hook (ex.: set -u) com o trap do lock_dev saía com 0 (a P16 "passou" sem medir)
    if [ -z "$step" ]; then ( . "./$hook" ) || die "POC $id failed (see the output above)"; return 0; fi
    if [ -f "${hook%pc.sh}$step.sh" ]; then ( . "./${hook%pc.sh}$step.sh" ) || die "POC $id $step failed (see the output above)"; return 0; fi
  fi
  # Parametros `--nome valor` viram query. Sem isto o CLI ACEITAVA `--turno 5483` e o DESCARTAVA em
  # silencio: o harness recebia `turno` vazio, gravava `realTurnMs: null`, e o C3 recusava projetar —
  # enquanto quem seguiu o README achava que tinha passado o numero. Documentar uma opcao que a ferramenta
  # ignora e pior que nao ter a opcao.
  local extra="" nome valor
  shift 2 2>/dev/null || shift $# # sobra: tudo depois de <id> [step]
  while [ $# -gt 0 ]; do
    case "$1" in
      --*)
        nome=${1#--}
        valor="${2:-}"
        printf '%s' "$nome" | grep -qE '^[a-z][a-z0-9_]*$' || die "invalid option: --$nome"
        printf '%s' "$valor" | grep -qE '^[A-Za-z0-9._-]+$' || die "invalid value for --$nome: '$valor' (letters, digits, dot, dash and underscore only)"
        extra="$extra&$nome=$valor"
        shift 2
        ;;
      *) die "unexpected argument: $1" ;;
    esac
  done
  say "POC $id on dev (may take a few minutes)"
  case "$id" in p3|p22) trace="&trace=0" ;; esac # a própria POC não pode contaminar a medição do gatilho ocioso
  r=$(remote "poc&id=$id${step:+&step=$step}$trace$extra") || die "the web app call failed (run ./gasclaw doctor)"
  # Uma POC que REPROVA não é um travamento. Antes, o exit 1 caía no trap de erro do script e
  # imprimia "gasclaw stopped unexpectedly", fazendo um resultado VÁLIDO parecer defeito de
  # ferramenta — e empurrando quem mede a duvidar do próprio número em vez de acreditar nele.
  # Isso corrompe a medição por via psicológica, que é a mais difícil de detectar.
  # `set +e` NAO basta: medido neste bash, o trap de ERR dispara mesmo com ele desligado (e reporta a
  # linha da DEFINICAO da funcao, o que fazia a mensagem apontar para o lugar errado). Quem cala o trap e
  # `trap - ERR`. Aqui a saida != 0 e ESPERADA — e o resultado da medicao.
  trap - ERR
  set +e
  printf '%s' "$r" | node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{let r;try{r=JSON.parse(s)}catch{console.error(s.slice(0,500));process.exit(2)}console.log(JSON.stringify(r,null,2));process.exit(r.pass===true?0:1)})'
  local code=$?
  set -e
  [ "$code" -eq 0 ] || warn "POC $id did not pass — this is a MEASUREMENT RESULT, not a crash. A failed criterion is the deliverable."
  # `return` levaria o codigo ao chamador e o trap dispararia la, e de novo no `case` do fim: o resultado
  # valido saia acompanhado de DUAS mensagens de travamento. `poc` e comando terminal, entao sai aqui.
  exit "$code"
}

jsfield() { node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{let r;try{r=JSON.parse(s)}catch{console.error(s.slice(0,300));process.exit(2)}if(!r.ok){console.error(r.error);process.exit(1)}console.log(r[process.argv[1]])})' "$1"; }

cmd_trace() { # árvore de um run (sem id: o mais recente)
  local id="${1:-}"
  [ -z "$id" ] || printf '%s' "$id" | grep -qE '^[0-9A-Za-z-]+$' || die "invalid run id: $id"
  remote "trace${id:+&run=$id}" | jsfield tree
}

cmd_runs() { # abre a planilha "gasclaw — execuções"
  local u
  u=$(remote runs | jsfield url) || die "could not get the spreadsheet (run ./gasclaw doctor)"
  open_url "$u"
  ok "spreadsheet: $u"
}

cmd_limits() { # painel de limites no terminal (cache de 10 min; --fresh ignora)
  local fresh=""
  for a in "$@"; do [ "$a" = "--fresh" ] && fresh="&fresh=1"; done
  remote "limits$fresh" | node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{const r=JSON.parse(s);if(!r.ok){console.error(r.error);process.exit(1)}
const C={green:"\x1b[32m",yellow:"\x1b[33m",red:"\x1b[31m","no limit":"\x1b[2m"},Z="\x1b[0m",S={google:"reported by Google",openrouter:"reported by OpenRouter",gasclaw:"measured by gasclaw"};
for(const i of r.items){const pct=i.total&&i.used!==null?Math.min(100,Math.round(i.used/i.total*100)):null;const bar=pct===null?"          ":"█".repeat(Math.round(pct/10)).padEnd(10,"░");
console.log(`${C[i.level]}${bar}${Z} ${String(pct===null?"—":pct+"%").padStart(4)}  ${i.label} · ${i.status==="ok"?`${i.used} / ${i.total??"∞"} ${i.unit}`:i.status.toUpperCase()} · [${S[i.source]}]${i.reset?" · reset "+i.reset:""}${i.note?" · "+i.note:""}`)}
console.log(`\n1-minute worker: ${r.trigger} · ${r.cached?"from cache (10 min)":"read just now"} · ${new Date(r.at).toLocaleString("pt-BR")}`)})'
}

cmd_usage() { # custo por modelo: 7 dias, ou as 24 h de um dia (AAAA-MM-DD, fuso de São Paulo)
  local day="${1:-}"
  [ -z "$day" ] || printf '%s' "$day" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || die "invalid day: $day (use YYYY-MM-DD)"
  remote "usage${day:+&day=$day}" | node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{const r=JSON.parse(s);if(!r.ok){console.error(r.error);process.exit(1)}
const max=Math.max(...r.chart.bars.map((b)=>b.total),1e-9);
for(const b of r.chart.bars)console.log(`${b.key.padEnd(10)} ${"█".repeat(Math.round(b.total/max*30)).padEnd(30)} US$ ${b.total}`);
console.log(`\n${r.day} by model:`);for(const t of r.table)console.log(`  ${t.model.padEnd(45)} ${String(t.req).padStart(5)} req ${String(t.tok).padStart(8)} tok  US$ ${t.cost}`);
const c=r.check;console.log(`\ncross-check (UTC day ${c.dayUtc}): measured by gasclaw US$ ${c.measured} × reported by OpenRouter US$ ${c.informed??"?"}${c.diffPct!==null?` (${c.diffPct}%)`:""} · ${c.nota} · queue: ${r.queue}`)})'
}

cmd_eval() {
  lock_dev
  [ "$TARGET" = dev ] || die "evals run on dev only"
  # MESMO defeito que as POCs ja tinham, por outro caminho: o runner usa exit 2 tanto para 'recusei e
  # te expliquei o motivo' (cenario offline, que so roda no npm test) quanto para 'quebrei'. A trap de
  # ERR nao distingue os dois, entao ela imprimia 'stopped unexpectedly … please report this' logo
  # abaixo de uma recusa perfeitamente explicada — mandando a pessoa abrir um bug por um comportamento
  # correto. Corromper a medicao por via psicologica e o pior tipo: ninguem confere o que ja acredita
  # estar quebrado.
  #
  # `set +e` NAO basta (medido neste bash): quem cala o trap e `trap - ERR`.
  trap - ERR
  set +e
  node scripts/eval.mjs "$(url)" "$@"
  local code=$?
  set -e
  # O runner ja disse o que houve na linha acima. Repetir aqui viraria ruido; o que falta e so nao
  # FINGIR que foi crash. Um eval reprovado tambem sai != 0, e isso e resultado, nao defeito.
  exit "$code"
}

cmd_tools() { # ferramentas do agente: ./gasclaw tools all | none | <nomes,separados,por,vírgula> [pasta]
  local set="${1:-}" folder="${2:-}"
  [ -n "$set" ] || die "usage: ./gasclaw tools all|none|<comma,separated,names> [folderId]"
  printf '%s' "$set" | grep -qE '^[a-z0-9_.,-]+$' || die "invalid list: $set"
  remote "tools&set=$set${folder:+&folder=$folder}" | node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{const r=JSON.parse(s);if(!r.ok){console.error(r.error);process.exit(1)}
console.log(`${r.agent}: ${r.enabled.length} tool(s) enabled`);for(const t of r.enabled)console.log("  "+t);
console.log(`people: ${r.users.length?r.users.join(", "):"owner only"}`)})'
}

cmd_swarm() { # a corrida do enxame (F6): ./gasclaw swarm <battery|interval|budget|run|measure|status>
  local sub="${1:-}"; shift || true
  local folder="${SWARM_FOLDER:-}"
  case "$sub" in
    capability) # ./gasclaw swarm capability <nome> on|off  — mesma autoridade do painel, provada pelo segredo
      [ -n "${2:-}" ] || die "usage: ./gasclaw swarm capability <name> on|off"
      remote "capability&cap=$1&on=$([ "$2" = on ] && echo 1 || echo 0)${folder:+&folder=$folder}" | swarm_print ;;
    battery) # ./gasclaw swarm battery <arquivo.json>  — declara o que é "melhor" (portão H5)
      [ -f "${1:-}" ] || die "usage: ./gasclaw swarm battery <file.json>"
      # A bateria tem aspas, virgulas e quebras de linha: vai codificada, senao quebra a query do POST.
      local enc; enc=$(node -e 'process.stdout.write(encodeURIComponent(JSON.stringify(JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")))))' "$1")
      remote "battery&set=$enc${folder:+&folder=$folder}" | swarm_print ;;
    interval) # ./gasclaw swarm interval <minutos>  — o piso de 60 min e do nucleo, nao daqui
      [ -n "${1:-}" ] || die "usage: ./gasclaw swarm interval <minutes>"
      remote "interval&ms=$(( $1 * 60000 ))${folder:+&folder=$folder}" | swarm_print ;;
    budget) # ./gasclaw swarm budget <codegen> <family> <horas> | ./gasclaw swarm budget end
      if [ "${1:-}" = end ]; then remote "budget&end=1" | swarm_print; else
        [ -n "${3:-}" ] || die "usage: ./gasclaw swarm budget <codegenUsd> <familyUsd> <hours> | end"
        remote "budget&codegen=$1&family=$2&hours=$3" | swarm_print; fi ;;
    run) # ./gasclaw swarm run "<objetivo>"  — GASTA OPUS e implanta um projeto filho
      [ -n "${1:-}" ] || die "usage: ./gasclaw swarm run \"<goal>\" [scope,scope]"
      # SWARM_TOKENS baixa o teto de tokens desta geracao (nunca sobe: o maximo vem do crivo). Serve para
      # caber no credito da chave, ou no tamanho esperado do filho. Vazio = o maximo que o crivo aceita.
      remote "automate&goal=$(node -e 'process.stdout.write(encodeURIComponent(process.argv[1]))' "$1")&scopes=${2:-https://www.googleapis.com/auth/userinfo.email}${SWARM_TOKENS:+&tokens=$SWARM_TOKENS}${folder:+&folder=$folder}" | swarm_print ;;
    measure) # ./gasclaw swarm measure <scriptId>  — so mede filho JA autorizado pelo dono
      [ -n "${1:-}" ] || die "usage: ./gasclaw swarm measure <scriptId>"
      remote "measure&child=$1" | swarm_print ;;
    status) remote "lineage" | swarm_lineage ;;
    *) die "usage: ./gasclaw swarm capability <name> on|off | battery <file> | interval <min> | budget <c> <f> <h>|end | run \"<goal>\" | measure <id> | status" ;;
  esac
}

# Uma RECUSA do servidor ("succeed is off for this agent") e um RESULTADO, nao um crash: ela diz o que
# o dono precisa fazer. Sair com 1 fazia o `set -e` matar o script com "stopped unexpectedly near line
# 808" — escondendo a frase util atras de um erro que parece defeito nosso. Mesma regra do runner de POC.
swarm_print() { node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{let r;try{r=JSON.parse(s)}catch{console.error(s.slice(0,200));return}
if(r.ok===false||r.measured===false){console.log("refused: "+(r.error||r.reason));return}
console.log(JSON.stringify(r,null,1))})'; }

swarm_lineage() { node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{const r=JSON.parse(s);
const cg=(r.entries||[]).filter((e)=>e.kind==="codegen");
if(!cg.length){console.log("no generation yet");process.exit(0)}
console.log("gen  child                 passes   rate    delta     cost");
for(const e of cg){const rate=Number.isInteger(e.passes)&&e.k?(e.passes/e.k):null;
console.log(`${String(e.generation).padEnd(4)} ${e.child.slice(0,20).padEnd(21)} ${rate===null?"not measured":String(e.passes)+"/"+e.k} ${rate===null?"      ":("   "+(rate*100).toFixed(0)+"%").padStart(7)} ${e.delta===null||e.delta===undefined?"     -":(e.delta>=0?"+":"")+e.delta.toFixed(3)}  US$ ${(e.costUsd||0).toFixed(2)}`)}
const t=cg.reduce((a,e)=>a+(e.costUsd||0),0);console.log(`\ntotal spent: US$ ${t.toFixed(2)}`)})'; }

cmd_rollback() {
  lock_dev # B4
  local d cur
  d=$(var "DEPLOY_ID_$UP")
  [ -n "$d" ] || die "no deployment in $TARGET"
  cur=$(clasp_ list-deployments | grep "$d" | grep -oE '@[0-9]+' | tr -d @ | head -1 || true)
  { [ -n "$cur" ] && [ "$cur" -gt 1 ]; } || die "no previous version (current: ${cur:-?})"
  clasp_ create-deployment -i "$d" -V "$((cur - 1))" -d "rollback" >/dev/null
  ok "$TARGET rolled back to version $((cur - 1))"
}


# ---------- onboarding: o mapa do setup, um passo por vez ----------
#
# O `up` ja faz o setup inteiro de uma vez. Isto existe para o caso oposto: quem acabou de clonar e nao sabe
# o que vai acontecer, quantos passos faltam, nem por que cada um existe. O `doctor` diz o que esta quebrado;
# este menu diz onde voce esta e qual e o proximo passo.
#
# Cada passo e um par: um TESTE (ja esta feito?) e uma ACAO. Os dois saem do que ja existe no arquivo — nada
# de um segundo caminho de setup que possa divergir do `up`.

STEP_TITLES="Local tools|Google account|Google Cloud project|OpenRouter key|Web app (dev)|Your first agent|Google Chat"
STEP_WHYS="node, gcloud and clasp on this machine|the account that will own the agents|hosts the Apps Script project and its APIs|the model provider — without it the agent cannot think|puts the panel and the 1-minute worker online|a Drive folder with four markdown files|optional: talk to your agent from Google Chat"

# O menu le SO estado local. A primeira versao perguntava o health e listava as implantacoes a cada
# renderizacao: 18 segundos para desenhar um menu. Quem chega num projeto novo nao espera 18 s por uma lista.
# O flag AGENT_OK_<env> e gravado pelo `health`, que ja faz essa chamada dentro do `up`.

step_done() { # $1 numero do passo -> 0 se ja esta feito
  case "$1" in
    1) have node && have gcloud && [ -x node_modules/.bin/clasp ] ;;
    2) [ -n "$(var ACCOUNT)" ] && [ -f "$HOME/.clasprc.json" ] && [ -n "$(var APPS_SCRIPT_API_OK)" ] ;;
    3) [ -n "$(var "GCP_PROJECT_$UP")" ] && [ -n "$(var "CONSENT_OK_$UP")" ] ;;
    4) [ -n "${OPENROUTER_API_KEY:-}" ] ;;
    5) [ -n "$(var "DEPLOY_ID_$UP")" ] ;;
    6) [ -n "$(var "AGENT_OK_$UP")" ] ;;
    7) is_personal || [ -n "$(var "CHAT_OK_$UP")" ] ;; # em conta pessoal o passo nao se aplica: conta como resolvido
    *) return 1 ;;
  esac
}

# O que falta num passo que AINDA nao foi feito. So o passo 1 precisa disto hoje: numa maquina zerada ele e
# o unico que pode parar por falta de coisa externa, e descobrir isso depois de apertar `a` e o pior momento.
step_missing() {
  case "$1" in
    1)
      local falta=""
      [ "$(os_kind)" = mac ] && { have brew || falta="Homebrew (install it from https://brew.sh first)"; }
      if [ -z "$falta" ]; then
        have node   || falta="node"
        have gcloud || falta="${falta:+$falta, }gcloud"
        [ -x node_modules/.bin/clasp ] || falta="${falta:+$falta, }npm deps"
        # "will install" so e verdade no macOS PARA node e gcloud. Nos outros sistemas o gasclaw ORIENTA,
        # nao instala — prometer o contrario faria a pessoa apertar `a` esperando magica e receber um erro.
        # Mas `npm ci` e automatico em TODO sistema: dizer "step 1 tells you how" quando so falta isso e
        # mandar a pessoa procurar uma instrucao que nao existe.
        if [ -n "$falta" ]; then
          if [ "$(os_kind)" = mac ] || [ "$falta" = "npm deps" ]; then falta="will install: $falta"; else falta="needs: $falta (step 1 tells you how)"; fi
        fi
      fi
      printf '%s' "$falta" ;;
    *) printf '' ;;
  esac
}

step_detail() { # confirmacao curta do passo FEITO — repetir o "porque" numa linha com ✓ so confunde
  case "$1" in
    1) printf 'installed' ;;
    2) var ACCOUNT ;;
    3) var "GCP_PROJECT_$UP" ;;
    4) printf 'in .env.local' ;;
    5) printf 'published' ;;
    6) printf 'created' ;;
    7) if is_personal; then printf 'n/a on personal accounts'; else printf 'connected'; fi ;;
    *) printf '' ;;
  esac
}

ask_openrouter_key() { # a pessoa digita; nunca ecoamos, e o arquivo nasce 600
  printf '\n  An OpenRouter key looks like sk-or-v1-...  Get one at https://openrouter.ai/keys\n'
  printf '  Paste it here (input is hidden, Enter to skip): '
  local k
  read -rs k
  printf '\n'
  [ -n "$k" ] || { warn "skipped: without a key the agent cannot answer"; return 0; }
  case "$k" in sk-or-*) ;; *) die "that does not look like an OpenRouter key (it starts with sk-or-)" ;; esac
  touch .env.local
  chmod 600 .env.local
  grep -v '^OPENROUTER_API_KEY=' .env.local > .env.local.tmp 2>/dev/null || true
  printf 'OPENROUTER_API_KEY=%s\n' "$k" >> .env.local.tmp
  mv .env.local.tmp .env.local
  export OPENROUTER_API_KEY="$k"
  ok "key saved in .env.local (gitignored, never committed)"
}

step_run() {
  case "$1" in
    1) ensure_tools ;;
    2) ensure_auth ;;
    3) ensure_gcp ;;
    4) ask_openrouter_key ;;
    5) cmd_up ;;
    6) [ -n "$(var "DEPLOY_ID_$UP")" ] || die "publish the web app first (step 5)"
       say "the panel opens: click \"New agent\", pick a name, and come back"
       open_url "$(url)"
       printf '  Press Enter when the agent is created… '
       read -r _
       health
       # O momento em que o endereco importa: o agente existe e a pessoa quer falar com ele, talvez do
       # celular. Aqui a chave ja foi colada no passo 5, entao copiar o link nao atropela nada.
       show_link "$(chat_url)" "talk to your agent" ;; # confirma de verdade, uma vez: e o `health` que grava o flag que o menu le
    7) is_personal && { warn "Google Chat apps need a Google Workspace account; everything else works on a personal account"; return 0; }
       [ -n "$(var "GCP_PROJECT_$UP")" ] || die "create the Google Cloud project first (step 3)"
       pause "CHAT_OK_$UP" "https://console.cloud.google.com/apis/api/chat.googleapis.com/hangouts-chat?project=$(var "GCP_PROJECT_$UP")" \
         "Google Chat API: set App name 'gasclaw', enable Interactive features, choose 'App URL' and paste $(url) — then Save." ;;
    *) warn "no such step: $1" ;;
  esac
}

onboard_menu() {
  local i done=0 total=7 mostrados mark title why detail falta
  printf '\n\033[1m🦀 gasclaw\033[0m — agents that live in your Google Drive\n'
  # O passo 7 conta como resolvido em conta pessoal mas e desenhado "—": contando-o, o cabecalho dizia
  # "2 of 7" com um unico ✓ na tela. Passo que nao se aplica sai do numerador E do denominador.
  mostrados=$total
  is_personal && mostrados=$((total - 1))
  for i in $(seq 1 $total); do
    { [ "$i" = 7 ] && is_personal; } && continue
    step_done "$i" >/dev/null 2>&1 && done=$((done + 1))
  done
  local acct
  case "$(account_kind)" in
    personal)  acct="personal account ($(var ACCOUNT)) · Google Chat unavailable" ;;
    workspace) acct="Google Workspace ($(var DOMAIN))" ;;
    *)         acct="account not detected yet — run step 2" ;;
  esac
  printf '\n  Setup · \033[1m%s of %s\033[0m done · environment: %s\n  \033[2m%s\033[0m\n\n' "$done" "$mostrados" "$TARGET" "$acct"
  for i in $(seq 1 $total); do
    title=$(printf '%s' "$STEP_TITLES" | cut -d'|' -f"$i")
    why=$(printf '%s' "$STEP_WHYS" | cut -d'|' -f"$i")
    if [ "$i" = 7 ] && is_personal; then
      printf '  \033[2m—\033[0m %s  %-22s \033[2mnot available on personal accounts (needs Google Workspace)\033[0m\n' "$i" "$title"
    elif step_done "$i" >/dev/null 2>&1; then
      detail=$(step_detail "$i")
      printf '  \033[32m✓\033[0m %s  %-22s \033[2m%s\033[0m\n' "$i" "$title" "${detail:-$why}"
    else
      falta=$(step_missing "$i")
      printf '  \033[33m○\033[0m %s  %-22s \033[2m%s\033[0m\n' "$i" "$title" "${falta:-$why}"
    fi
  done
  if [ "$done" -eq "$mostrados" ]; then
    printf '\n  \033[32mEverything is set up.\033[0m Talk to your agent: %s\n' "$(url)"
  fi
  printf '\n  \033[2m[1-%s] run a step   [a] run everything missing   [r] refresh   [d] diagnose   [q] quit\033[0m\n' "$total"
}

cmd_onboard() {
  [ -t 0 ] || die "onboarding needs a terminal (run ./gasclaw onboard by hand)"
  local choice i
  while :; do
    onboard_menu
    printf '\n> '
    read -r choice || return 0
    case "$choice" in
      q|Q|'') printf '\n'; return 0 ;;
      # O menu le estado local para ser instantaneo; isto e a valvula para quando o estado mudou por fora
      # (agente criado noutra aba, por exemplo). UMA chamada, so quando a pessoa pede.
      r|R) printf '\n'; health ;;
      d|D) printf '\n'; cmd_doctor ;;
      a|A) for i in $(seq 1 7); do step_done "$i" >/dev/null 2>&1 || { printf '\n'; step_run "$i"; }; done ;;
      [1-7]) printf '\n'; step_run "$choice" ;;
      *) warn "type a number from 1 to 7, or a / d / q" ;;
    esac
  done
}

cmd_help() { cat <<'TXT'
gasclaw — agents that live in your Google Drive, running on Google Apps Script

  ./gasclaw up [--prod]       set up (first time), publish, and open the panel
  ./gasclaw down [--prod]     pause every agent
  ./gasclaw restart [--prod]  down + up
  ./gasclaw ship              publish to prod (same URL)
  ./gasclaw logs [--prod]     live logs
  ./gasclaw status [--prod]   ids, URLs, deployments and health
  ./gasclaw doctor [--prod]   diagnose what is broken and how to fix it
  ./gasclaw rollback [--prod] go back to the previous version
  ./gasclaw open [--prod]     open the gasclaw panel
  ./gasclaw open --chat       open the chat with your agent (works without Google Workspace)
  ./gasclaw poc <id> [step]   run a POC on dev and show the result (e.g. poc p6, poc p10)
  ./gasclaw trace [id]        step tree of one agent run (no id: the most recent)
  ./gasclaw runs              open the runs spreadsheet in Drive
  ./gasclaw limits [--fresh]  limits panel (reported by Google and OpenRouter, measured by gasclaw)
  ./gasclaw usage [YYYY-MM-DD]  cost per model: last 7 days, or the 24 h of one day
  ./gasclaw eval <scenario|--all> [--model id]  run evals/*.md on dev (exit != 0 on failure)
  ./gasclaw tools all|none|<a,b,c> [folder]     turn the agent's tools on and off
  ./gasclaw swarm <sub>       the swarm run: battery, interval, budget, run, measure, status
