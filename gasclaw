#!/usr/bin/env bash
# gasclaw — ponto de entrada único e idempotente.  Uso: ./gasclaw <comando> [--prod]
set -euo pipefail
cd "$(dirname "$0")"
export PATH="$PATH:/usr/local/share/google-cloud-sdk/bin:/opt/homebrew/share/google-cloud-sdk/bin"

ENV_FILE=gasclaw.env
touch "$ENV_FILE"
set -a
. "./$ENV_FILE"
[ -f .env.local ] && . ./.env.local
set +a

CMD="${1:-help}"
[ $# -gt 0 ] && shift
TARGET=dev
for a in "$@"; do [ "$a" = "--prod" ] && TARGET=prod; done
UP=$(printf '%s' "$TARGET" | tr '[:lower:]' '[:upper:]')

say()  { printf '\033[1;36m▸ %s\033[0m\n' "$*"; }
ok()   { printf '\033[32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*"; }
die()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
var()  { eval "printf '%s' \"\${$1:-}\""; }
setvar() {
  grep -v "^$1=" "$ENV_FILE" > "$ENV_FILE.tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
  eval "export $1=\"\$2\""
}
pause() { # $1 chave de concluído · $2 URL a abrir (ou vazio) · $3 instrução
  [ -n "$(var "$1")" ] && return 0
  [ -n "${CI:-}" ] && die "passo manual pendente: $3"
  printf '\n\033[33m⏸  %s\033[0m\n' "$3"
  [ -n "$2" ] && open "$2"
  printf '   Pressione Enter quando terminar… '
  read -r _
  setvar "$1" 1
}
LOCK_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gasclaw"
lock_dev() { # lock POR MÁQUINA (A4): os worktrees usam o mesmo SCRIPT_ID_DEV; reentrante no mesmo shell; liberado no EXIT
  [ -n "${GASCLAW_LOCKED:-}" ] && return 0 # sem export: nenhum processo filho chama o ./gasclaw (os pc.sh são carregados com ".")
  local lock="$LOCK_DIR/dev.lock" waited=0 pid stale
  mkdir -p "$LOCK_DIR"
  until mkdir "$lock" 2>/dev/null; do
    pid=$(cat "$lock/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      stale="$lock.orfao.$$" # B3: mv atômico; se outro processo já pegou o órfão, o mv falha e seguimos esperando
      if mv "$lock" "$stale" 2>/dev/null; then
        warn "lock órfão do PID $pid removido"
        rm -rf "$stale"
      fi
      continue
    fi
    [ "$waited" -ge "${GASCLAW_LOCK_TIMEOUT:-1200}" ] && die "dev ocupado pelo PID ${pid:-?} (esperei ${waited}s; lock em $lock)"
    [ $((waited % 30)) -eq 0 ] && say "dev ocupado pelo PID ${pid:-?}: aguardando o lock"
    sleep 5
    waited=$((waited + 5))
  done
  printf '%s\n' "$$" > "$lock/pid"
  GASCLAW_LOCKED=1
  trap "rm -rf '$lock'" EXIT # caminho absoluto: vale mesmo se o cwd mudar
}

clasp_() { # projeto privado por chamada: nenhum comando compartilha (nem reescreve) o .clasp.json da raiz
  # O clasp 3.4 recusa rootDir fora da pasta do .clasp.json ("srcDir escapes project root"): o alvo (CLASP_ROOT, padrão
  # dist) é COPIADO para $dir/root antes (o push publica essa cópia congelada) e, num pull, copiado de volta depois.
  local dir target="${CLASP_ROOT:-dist}" rc=0
  mkdir -p .tmp "$target"
  dir=$(mktemp -d "$PWD/.tmp/clasp.XXXXXX")
  mkdir -p "$dir/root"
  cp -R "$target/." "$dir/root/"
  printf '{"scriptId":"%s","rootDir":"root","projectId":"%s"}\n' "$(var "SCRIPT_ID_$UP")" "$(var "GCP_PROJECT_$UP")" > "$dir/.clasp.json"
  (cd "$dir" && npx --no-install clasp "$@") || rc=$?
  if [ "$rc" -eq 0 ] && [ "${1:-}" = pull ]; then cp -R "$dir/root/." "$target/"; fi
  rm -rf "$dir"
  return "$rc"
}
exec_url() { printf 'https://script.google.com/a/macros/%s/s/%s/exec' "${DOMAIN:-}" "$1"; }
url() { exec_url "$(var "DEPLOY_ID_$UP")"; }
sibling_url() { # P21: URL do painel do OUTRO ambiente, embutida no build. Só navegação: nada é lido do outro lado.
  local other d
  if [ "$TARGET" = dev ]; then other=PROD; else other=DEV; fi
  d=$(var "DEPLOY_ID_$other")
  if [ -n "$d" ]; then exec_url "$d"; fi
}
gfetch() { # $1 token · $2 URL · $3 corpo do POST ("" = GET) · $4 segredo (só no POST). Imprime o corpo; ≠ 0 se falhar.
  # Medido (ADR-020): mesmo com o token no salto, o echo do Google perde a resposta de vez em quando (404), sem relação
  # com duração nem concorrência (GET 1/20; POST 0/10 a 3/5 por rodada). GET é idempotente: tenta de novo. POST leva um
  # job aleatório: o servidor executa uma vez por job e guarda o resultado, que a CLI busca por GET se a resposta se perder.
  local t="$1" u="$2" d="$3" s="${4:-}" i r job base t0 unknown_since st
  if [ -z "$d" ]; then
    for i in 1 2 3; do
      if r=$(ghop "$t" "$u" "" ""); then printf '%s' "$r"; return 0; fi
      [ "$i" -lt 3 ] && sleep 2
    done
    return 22
  fi
  job=$(openssl rand -hex 8)
  if r=$(ghop "$t" "$u" "$d&job=$job" "$s"); then printf '%s' "$r"; return 0; fi
  printf 'a resposta do POST se perdeu no Google: buscando o resultado do job %s\n' "$job" >&2
  base="${u%%\?*}"; t0=$(date +%s); unknown_since=$t0
  while [ $(( $(date +%s) - t0 )) -lt 360 ]; do
    sleep 5
    r=$(ghop "$t" "$base?action=job&id=$job" "" "") || continue
    st=$(printf '%s' "$r" | node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{try{const j=JSON.parse(s);if(j.status==="done"){process.stdout.write(JSON.stringify(j.result));process.exit(0)}console.error(j.status||"?");process.exit(3)}catch{process.exit(4)}})' 2>/dev/null) && { printf '%s' "$st"; return 0; }
    if printf '%s' "$r" | grep -q '"status":"unknown"'; then
      [ $(( $(date +%s) - unknown_since )) -ge 60 ] && { printf 'job %s desconhecido no servidor depois de 60 s: o POST não chegou\n' "$job" >&2; return 22; }
    else
      unknown_since=$(date +%s)
    fi
  done
  printf 'job %s sem resultado em 6 min\n' "$job" >&2
  return 22
}

ghop() { # um único pedido ao web app: $1 token · $2 URL · $3 corpo do POST ("" = GET) · $4 segredo. Imprime o corpo; ≠ 0 se não for 200.
  # A resposta vem por 302 para script.googleusercontent.com/…/echo, que EXIGE o token e vale UMA vez; o curl -L não
  # reenvia o Authorization ao trocar de host. Aqui o salto é manual, com o token, e só para o host do echo do Google.
  local t="$1" u="$2" d="$3" s="${4:-}" out meta code loc rc=0
  mkdir -p .tmp
  out=$(mktemp "$PWD/.tmp/resp.XXXXXX")
  if [ -n "$d" ]; then
    meta=$(printf 'header = "Authorization: Bearer %s"\ndata-urlencode = "secret=%s"\n' "$t" "$s" | curl -sS --config - --data "$d" -o "$out" -w '%{http_code} %{redirect_url}' "$u") || rc=$?
  else
    meta=$(printf 'header = "Authorization: Bearer %s"\n' "$t" | curl -sS --config - -o "$out" -w '%{http_code} %{redirect_url}' "$u") || rc=$?
  fi
  code="${meta%% *}"; loc="${meta#* }"; [ "$loc" = "$meta" ] && loc=""
  if [ "$rc" -eq 0 ] && [ "$code" = 302 ] && [ -n "$loc" ]; then
    case "$loc" in
      https://script.googleusercontent.com/*)
        meta=$(printf 'header = "Authorization: Bearer %s"\n' "$t" | curl -sS --config - -o "$out" -w '%{http_code} %{redirect_url}' "$loc") || rc=$?
        code="${meta%% *}" ;;
      *) rc=22; printf 'redirecionamento para host inesperado recusado (o token não sai do Google)\n' >&2 ;;
    esac
  fi
  if [ "$rc" -eq 0 ] && [ "$code" = 200 ]; then cat "$out"; else rc=${rc/#0/22}; printf 'web app respondeu HTTP %s\n' "${code:-?}" >&2; fi
  rm -f "$out"
  return "$rc"
}

remote_to() { # $1 URL base (…/exec ou …/dev) · $2 "acao&a=b" (já no formato de querystring) · $3 token (opcional, reaproveitado)
  local t="${3:-}" action="${2%%&*}"
  [ -n "$t" ] || t=$(gcloud auth print-access-token 2>/dev/null) || return 1
  case " eval poc enable disable drain " in
    *" $action "*) # M1: ação com efeito → POST; parâmetros no corpo; token e segredo pelo stdin, nunca em argv nem na URL
      [ -n "${CLI_SECRET:-}" ] || { die "sem CLI_SECRET no .env.local: rode ./gasclaw up (ele gera e registra o segredo)"; return 1; }
      gfetch "$t" "$1" "action=$2" "$CLI_SECRET" ;;
    *) # leitura → GET; token pelo stdin
      gfetch "$t" "$1?action=$2" "" ;;
  esac
}
remote() { remote_to "$(url)" "$1"; }

ensure_cli_secret() { # M1: segredo da CLI gerado no PC (.env.local, gitignored; nunca gasclaw.env) e registrado no web app pelo dono
  local r t
  if [ -z "${CLI_SECRET:-}" ]; then
    CLI_SECRET=$(openssl rand -hex 32)
    touch .env.local
    chmod 600 .env.local
    if [ -s .env.local ] && [ -n "$(tail -c1 .env.local)" ]; then printf '\n' >> .env.local; fi
    printf 'CLI_SECRET=%s\n' "$CLI_SECRET" >> .env.local
    export CLI_SECRET
    ok "segredo da CLI gerado em .env.local"
  fi
  t=$(gcloud auth print-access-token 2>/dev/null || true)
  r=$(gfetch "$t" "$(url)" "action=setsecret" "$CLI_SECRET" 2>/dev/null || true)
  case "$r" in
    *'"ok":true'*) ok "segredo da CLI registrado no web app" ;;
    *) warn "segredo da CLI não registrado (${r:0:120}): as ações com efeito (poc, eval, down) falham até o próximo up" ;;
  esac
}

ensure_tools() {
  command -v brew >/dev/null || die "Homebrew não encontrado: instale em https://brew.sh e rode de novo"
  command -v node >/dev/null || brew install node
  command -v gcloud >/dev/null || brew install --cask google-cloud-sdk
  [ -x node_modules/.bin/clasp ] || npm ci
  ok "ferramentas"
}

ensure_auth() {
  local acct
  acct=$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -1)
  if [ -z "$acct" ]; then
    say "login no Google Cloud (abre o navegador)"
    gcloud auth login --enable-gdrive-access
    acct=$(gcloud auth list --filter=status:ACTIVE --format='value(account)' | head -1)
  fi
  setvar ACCOUNT "$acct"
  setvar DOMAIN "${acct#*@}"
  if [ ! -f "$HOME/.clasprc.json" ]; then
    say "login no clasp (abre o navegador)"
    npx --no-install clasp login
  fi
  pause APPS_SCRIPT_API_OK "https://script.google.com/home/usersettings" "Ligue 'Google Apps Script API' (On)."
  ok "autenticado como $ACCOUNT"
}

ensure_gcp() {
  local p
  p=$(var "GCP_PROJECT_$UP")
  if [ -z "$p" ]; then
    p="gasclaw-$TARGET-$(openssl rand -hex 3)"
    say "criando projeto GCP $p"
    gcloud projects create "$p" --name="gasclaw $TARGET"
    setvar "GCP_PROJECT_$UP" "$p"
  fi
  gcloud services enable script.googleapis.com chat.googleapis.com iamcredentials.googleapis.com drive.googleapis.com sheets.googleapis.com logging.googleapis.com monitoring.googleapis.com tasks.googleapis.com people.googleapis.com calendar-json.googleapis.com gmail.googleapis.com --project "$p" >/dev/null
  setvar "GCP_NUMBER_$UP" "$(gcloud projects describe "$p" --format='value(projectNumber)')"
  pause "CONSENT_OK_$UP" "https://console.cloud.google.com/auth/branding?project=$p" \
    "Tela de consentimento OAuth: público INTERNO, nome 'gasclaw', e-mail de suporte $ACCOUNT. Salve."
  ok "projeto GCP $p"
}

ensure_chat_identity() { # P2: identidade do app por impersonacao; nenhuma chave e criada ou baixada
  local p sa role policy
  p=$(var "GCP_PROJECT_$UP")
  sa="gasclaw-chat@$p.iam.gserviceaccount.com"
  role="projects/$p/roles/gasclawChatTokenMinter"
  if ! gcloud iam service-accounts describe "$sa" --project "$p" >/dev/null 2>&1; then
    say "criando identidade do Google Chat"
    gcloud iam service-accounts create gasclaw-chat --display-name="gasclaw Chat app" --project "$p" >/dev/null
  fi
  if ! gcloud iam roles describe gasclawChatTokenMinter --project "$p" >/dev/null 2>&1; then
    gcloud iam roles create gasclawChatTokenMinter --project "$p" --title="gasclaw Chat token minter" \
      --description="Somente emite access token efemero para o Chat app" --permissions=iam.serviceAccounts.getAccessToken --stage=GA >/dev/null
  else
    gcloud iam roles update gasclawChatTokenMinter --project "$p" --title="gasclaw Chat token minter" \
      --description="Somente emite access token efemero para o Chat app" --permissions=iam.serviceAccounts.getAccessToken --stage=GA >/dev/null
  fi
  # Conta dedicada: substitui a policy inteira por um unico principal e um unico papel minimo.
  policy=$(mktemp "${TMPDIR:-/tmp}/gasclaw-chat-policy.XXXXXX")
  printf '{"version":1,"bindings":[{"role":"%s","members":["user:%s"]}]}\n' "$role" "$ACCOUNT" > "$policy"
  gcloud iam service-accounts set-iam-policy "$sa" "$policy" --project "$p" --quiet >/dev/null
  rm -f "$policy"
  setvar "CHAT_SA_EMAIL_$UP" "$sa"
  ok "identidade do Chat sem chave: $sa"
}

ensure_script() {
  if [ -z "$(var "SCRIPT_ID_$UP")" ]; then
    rm -f .clasp.json
    mkdir -p dist
    npx --no-install clasp create-script --type standalone --title "gasclaw-$TARGET" --rootDir dist
    setvar "SCRIPT_ID_$UP" "$(node -p 'require("./.clasp.json").scriptId')"
  fi
  pause "GCP_LINKED_$UP" "https://script.google.com/home/projects/$(var "SCRIPT_ID_$UP")/settings" \
    "Configurações do projeto → Projeto do Google Cloud → Alterar projeto → cole o número $(var "GCP_NUMBER_$UP") → Definir projeto."
  ok "script $(var "SCRIPT_ID_$UP")"
}

pull_into() { # $1 pasta; o pull do HEAD falha às vezes por rede: 3 tentativas
  local i
  for i in 1 2 3; do
    CLASP_ROOT="$1" clasp_ pull >/dev/null && return 0
    warn "clasp pull falhou (tentativa $i de 3)"
    sleep 3
  done
  die "clasp pull falhou 3 vezes: não publico para não apagar edições feitas no editor"
}

keep_editor_agents() { # ADR-013: o push --force troca o HEAD inteiro; antes, traz os arquivos agentes/** editados no editor
  local r=.tmp/remote n
  rm -rf "$r" dist/agentes
  mkdir -p "$r"
  pull_into "$r"
  if [ -d "$r/agentes" ]; then cp -R "$r/agentes" dist/; fi
  n=$(find dist/agentes -type f 2>/dev/null | wc -l | tr -d ' ')
  ok "arquivos do editor preservados: $n"
}

deploy() {
  lock_dev
  mkdir -p .tmp
  say "testes"
  npm test > .tmp/test.log 2>&1 || die "testes falharam: veja .tmp/test.log" # o build.test gera numa pasta temporária
  say "build (logo antes do push)"
  export GCP_NUMBER="$(var "GCP_NUMBER_$UP")" # Monitoring (ADR-016)
  export CHAT_SA_EMAIL="$(var "CHAT_SA_EMAIL_$UP")" # P2: email publico da identidade, nunca credencial
  if [ "$TARGET" = dev ]; then export GASCLAW_DEV=1; else export GASCLAW_DEV=0; fi # POCs só no build do dev (M1)
  export GASCLAW_ENV="$TARGET"          # P21: rótulo do ambiente no cabeçalho do painel
  export SIBLING_URL="$(sibling_url)"   # P21: link para o painel irmão (vazio enquanto o outro não tiver implantação)
  OUT_DIR=dist npm run build > .tmp/build.log 2>&1 || die "build falhou: veja .tmp/build.log"
  local built
  built=$(shasum -a 256 dist/_motor.js dist/appsscript.json | cut -d' ' -f1 | tr '\n' ' ')
  keep_editor_agents # depois do build: o build.mjs apaga o dist/ inteiro, e os agentes/** do editor precisam ir junto
  check_bundle "$built"
  say "push ($TARGET)"
  clasp_ push --force >/dev/null
  verify_head
  publish
}

same_as_build() { # $1 pasta baixada → "" se o motor, as telas e o manifesto (escopos ordenados + webapp + chat) batem com o dist/
  local f bad=""
  for f in _motor.js settings.html chat.html; do
    cmp -s "$1/$f" "dist/$f" || bad="$bad $f"
  done
  node -e 'const k=(p)=>{const m=JSON.parse(require("fs").readFileSync(p,"utf8"));return JSON.stringify([[...(m.oauthScopes||[])].sort(),m.webapp,m.chat])};process.exit(k(process.argv[1])===k("dist/appsscript.json")?0:1)' "$1/appsscript.json" 2>/dev/null || bad="$bad appsscript.json"
  printf '%s' "$bad"
}

verify_head() { # depois do push e antes da versão: o HEAD remoto (pull isolado) é exatamente o build
  local dir=".tmp/verify-$$" bad
  mkdir -p "$dir"
  pull_into "$dir"
  bad=$(same_as_build "$dir")
  rm -rf "$dir" # B2
  [ -z "$bad" ] || die "HEAD remoto diferente do build depois do push (${bad# }): não crio a versão"
  ok "HEAD remoto conferido: motor, telas e manifesto idênticos ao build ($(node -p 'JSON.parse(require("fs").readFileSync("dist/appsscript.json","utf8")).oauthScopes.length') escopos)"
}

verify_version() { # A5: a VERSÃO criada (imutável) é o build, antes de apontar a implantação para ela
  local v="$1" dir=".tmp/version-$1-$$" bad
  mkdir -p "$dir"
  CLASP_ROOT="$dir" clasp_ pull --versionNumber "$v" >/dev/null || { rm -rf "$dir"; die "não consegui baixar a versão $v: implantação NÃO apontada"; }
  bad=$(same_as_build "$dir")
  rm -rf "$dir"
  [ -z "$bad" ] || die "versão $v diferente do build (${bad# }): implantação NÃO apontada"
  ok "versão $v conferida: idêntica ao build"
}

check_bundle() { # $1 sha do build. A v18 saiu com o bundle da v17 porque o dist/ foi regravado entre o build e o push
  local n missing=""
  for n in $(grep -oE '^export function [A-Za-z0-9_]+' src/main.ts | awk '{print $3}'); do
    grep -q "^function $n(" dist/_motor.js || missing="$missing $n"
  done
  [ -z "$missing" ] || die "bundle desatualizado: faltam em dist/_motor.js:$missing"
  [ "$(shasum -a 256 dist/_motor.js dist/appsscript.json | cut -d' ' -f1 | tr '\n' ' ')" = "$1" ] || die "dist/ mudou entre o build e o push (npm test, build ou clasp rodando em paralelo?): não publico"
  ok "bundle conferido: $(grep -c '^export function' src/main.ts) funções globais, $(wc -c < dist/_motor.js | tr -d ' ') bytes"
}

version_label() { # SHA do commit, com -dirty se src/ ou o manifesto têm mudança não commitada
  local sha dirty=""
  sha=$(git rev-parse --short HEAD 2>/dev/null || echo local)
  [ -z "$(git status --porcelain -- src appsscript.json build.mjs 2>/dev/null)" ] || dirty="-dirty"
  printf 'gasclaw %s%s' "$sha" "$dirty"
}

publish() { # versão nova do HEAD + implantação fixa apontando para ela (mesma URL)
  local out v d
  out=$(clasp_ create-version "$(version_label)")
  v=$(printf '%s' "$out" | grep -oE 'ersion [0-9]+' | grep -oE '[0-9]+' | head -1 || true) # M19: sem || true, o pipefail matava o script calado
  [ -n "$v" ] || die "não consegui ler o número da versão: $out"
  verify_version "$v"
  d=$(var "DEPLOY_ID_$UP")
  if [ -z "$d" ]; then
    out=$(clasp_ create-deployment -V "$v" -d "gasclaw $TARGET")
    d=$(printf '%s' "$out" | grep -oE 'AKfy[A-Za-z0-9_-]+' | head -1 || true)
    [ -n "$d" ] || die "não consegui ler o ID da implantação: $out"
    setvar "DEPLOY_ID_$UP" "$d"
  else
    clasp_ create-deployment -i "$d" -V "$v" -d "gasclaw $TARGET" >/dev/null
  fi
  ok "$TARGET na versão $v → $(url)"
}

authorize() {
  local label="gasclaw"
  [ "$TARGET" = dev ] && label="gasclaw dev"
  pause "WEBAPP_AUTH_$UP" "$(url)" "Na aba aberta, escolha sua conta e clique em Permitir (primeira autorização)."
  pause "CHAT_OK_$UP" "https://console.cloud.google.com/apis/api/chat.googleapis.com/hangouts-chat?project=$(var "GCP_PROJECT_$UP")" \
    "Chat API → Configuração: nome '$label'; avatar https://fonts.gstatic.com/s/e/notoemoji/latest/1f980/512.png; descrição 'Agentes do Drive'; DESMARQUE 'Criar como complemento do Google Workspace'; Funcionalidade: receber mensagens 1:1 e participar de espaços; Conexão: Projeto do Apps Script → ID de implantação $(var "DEPLOY_ID_$UP"); Visibilidade: pessoas específicas do domínio $DOMAIN (ou o domínio todo); Salvar."
}

health() {
  local r
  r=$(remote health 2>/dev/null || true)
  case "$r" in
    *'"ok":true'*) ok "health: $r" ;;
    *) warn "health não confirmado automaticamente (abra $(url)). Resposta: ${r:0:160}" ;;
  esac
}

cmd_up() {
  lock_dev
  ensure_tools
  ensure_auth
  ensure_gcp
  [ "$TARGET" = dev ] && ensure_chat_identity
  ensure_script
  deploy
  ensure_cli_secret # ADR-022 (a): logo depois do deploy, antes de qualquer outra chamada ao web app
  authorize
  remote enable >/dev/null 2>&1 || true
  health
  # consentimento granular: escopo sem autorização vira exceção capturada, e o Google não pede sozinho
  if remote "limits&fresh=1" 2>/dev/null | grep -q '"status":"pendente"'; then
    warn "faltam permissões do Google: abra https://script.google.com/home/projects/$(var "SCRIPT_ID_$UP")/edit → arquivo _motor.gs → no menu de funções escolha \"authorize\" → ▶ Executar → Permitir (ou use \"Autorizar permissões\" no topo da tela)"
  fi
  if [ -n "${OPENROUTER_API_KEY:-}" ]; then
    printf '%s' "$OPENROUTER_API_KEY" | pbcopy
    # segurança baixa: a chave sai do clipboard em 90 s, se ainda for ela que estiver lá
    (sleep 90; [ "$(pbpaste 2>/dev/null)" = "$OPENROUTER_API_KEY" ] && printf '' | pbcopy) >/dev/null 2>&1 &
    say "chave OpenRouter copiada por 90 s — cole em 'Chave OpenRouter' na tela (só na primeira vez)"
  else
    warn "sem OPENROUTER_API_KEY no .env.local — cole a chave direto na tela"
  fi
  open "$(url)"
  ok "pronto ($TARGET): $(url)"
}

cmd_down()    { remote disable && echo && ok "agentes pausados ($TARGET)"; }
cmd_restart() { cmd_down || true; cmd_up; }
cmd_open()    { open "$(url)"; }

cmd_ship() {
  TARGET=prod; UP=PROD
  [ -n "$(var SCRIPT_ID_PROD)" ] || die "prod ainda não existe: rode ./gasclaw up --prod uma vez"
  deploy
  health
}

# RISCO (auditoria A5, registrado; CI adiado e ADR-008 mantido): o CI publica o prod logo depois do dev, sem ninguém olhar o
# dev. As travas (check_bundle, verify_head, verify_version) impedem bundle trocado, mas não um bug de comportamento.
cmd_ci() { # usado pelo GitHub Actions: sem pausas, sem gcloud
  [ -x node_modules/.bin/clasp ] || npm ci
  TARGET=dev; UP=DEV; deploy
  TARGET=prod; UP=PROD; deploy
}

cmd_logs() { clasp_ tail-logs --watch | grep -v '^PAST'; }

cmd_status() {
  printf 'ambiente:     %s\nconta:        %s\nprojeto GCP:  %s\neditor:       https://script.google.com/home/projects/%s/edit\nweb app:      %s\n\n' \
    "$TARGET" "${ACCOUNT:-?}" "$(var "GCP_PROJECT_$UP")" "$(var "SCRIPT_ID_$UP")" "$(url)"
  clasp_ list-deployments || true
  remote health && echo || warn "health indisponível"
}

check() { # $1 descrição · $2 comando · $3 correção
  if eval "$2" >/dev/null 2>&1; then ok "$1"; else warn "$1 → $3"; fi
}
cmd_doctor() {
  check "Node ≥ 20" 'node -e "process.exit(Number(process.versions.node.split(\".\")[0]) < 20 ? 1 : 0)"' "brew install node"
  check "gcloud instalado" 'command -v gcloud' "brew install --cask google-cloud-sdk"
  check "login gcloud" 'gcloud auth list --filter=status:ACTIVE --format="value(account)" | grep -q @' "gcloud auth login --enable-gdrive-access"
  check "login clasp" '[ -f "$HOME/.clasprc.json" ]' "npx clasp login"
  check "dependências npm" '[ -x node_modules/.bin/clasp ]' "npm ci"
  check "build e testes" 'npm run build && npm test' "rode 'npm test' para ver o erro"
  check "script $TARGET criado" '[ -n "$(var "SCRIPT_ID_$UP")" ]' "./gasclaw up"
  check "web app $TARGET publicado" '[ -n "$(var "DEPLOY_ID_$UP")" ]' "./gasclaw up"
  check "OPENROUTER_API_KEY no .env.local" '[ -n "${OPENROUTER_API_KEY:-}" ]' "crie .env.local com OPENROUTER_API_KEY=sk-or-…"
  check "health remoto" 'remote health | grep -q "\"ok\":true"' "abra a tela e autorize, ou: gcloud auth login --enable-gdrive-access"
}

cmd_poc() { # POCs automáticas, só no dev: cria fixtures, mede e sai ≠ 0 se algum critério falhar
  local id="${1:-}" step="${2:-}" r trace=""
  [ "$TARGET" = dev ] || die "POCs rodam só no dev"
  printf '%s' "$id" | grep -qE '^p[0-9]+$' || die "uso: ./gasclaw poc <id> [etapa]  (ex.: ./gasclaw poc p6)"
  [ -z "$step" ] || printf '%s' "$step" | grep -qE '^[a-z0-9]+$' || die "etapa inválida: $step"
  lock_dev # a POC inteira (deploy + medições) sem push de outra pista no meio
  local hook
  hook=$(ls poc/"$id"-*/pc.sh 2>/dev/null | head -1 || true)
  if [ -n "$hook" ]; then # POC com etapas no PC (clasp): pc.sh (tudo) ou <etapa>.sh orquestra e decide o exit
    # subshell + die: no bash 3.2, erro implícito do hook (ex.: set -u) com o trap do lock_dev saía com 0 (a P16 "passou" sem medir)
    if [ -z "$step" ]; then ( . "./$hook" ) || die "POC $id falhou (veja a saída acima)"; return 0; fi
    if [ -f "${hook%pc.sh}$step.sh" ]; then ( . "./${hook%pc.sh}$step.sh" ) || die "POC $id $step falhou (veja a saída acima)"; return 0; fi
  fi
  say "POC $id no dev (pode levar alguns minutos)"
  [ "$id" = p3 ] && trace="&trace=0" # a própria POC não pode contaminar a medição do gatilho ocioso
  r=$(remote "poc&id=$id${step:+&step=$step}$trace") || die "chamada ao web app falhou (rode ./gasclaw doctor)"
  printf '%s' "$r" | node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{let r;try{r=JSON.parse(s)}catch{console.error(s.slice(0,500));process.exit(2)}console.log(JSON.stringify(r,null,2));process.exit(r.pass===true?0:1)})'
}

jsfield() { node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{let r;try{r=JSON.parse(s)}catch{console.error(s.slice(0,300));process.exit(2)}if(!r.ok){console.error(r.error);process.exit(1)}console.log(r[process.argv[1]])})' "$1"; }

cmd_trace() { # árvore de um run (sem id: o mais recente)
  local id="${1:-}"
  [ -z "$id" ] || printf '%s' "$id" | grep -qE '^[0-9A-Za-z-]+$' || die "id de run inválido: $id"
  remote "trace${id:+&run=$id}" | jsfield tree
}

cmd_runs() { # abre a planilha "gasclaw — execuções"
  local u
  u=$(remote runs | jsfield url) || die "não consegui obter a planilha (rode ./gasclaw doctor)"
  open "$u"
  ok "planilha: $u"
}

cmd_limits() { # painel de limites no terminal (cache de 10 min; --fresh ignora)
  local fresh=""
  for a in "$@"; do [ "$a" = "--fresh" ] && fresh="&fresh=1"; done
  remote "limits$fresh" | node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{const r=JSON.parse(s);if(!r.ok){console.error(r.error);process.exit(1)}
const C={verde:"\x1b[32m",amarelo:"\x1b[33m",vermelho:"\x1b[31m","sem limite":"\x1b[2m"},Z="\x1b[0m",S={google:"Google",openrouter:"OpenRouter",gasclaw:"medido"};
for(const i of r.items){const pct=i.total&&i.used!==null?Math.min(100,Math.round(i.used/i.total*100)):null;const bar=pct===null?"          ":"█".repeat(Math.round(pct/10)).padEnd(10,"░");
console.log(`${C[i.level]}${bar}${Z} ${String(pct===null?"—":pct+"%").padStart(4)}  ${i.label} · ${i.status==="ok"?`${i.used} / ${i.total??"∞"} ${i.unit}`:i.status.toUpperCase()} · [${S[i.source]}]${i.reset?" · reset "+i.reset:""}${i.note?" · "+i.note:""}`)}
console.log(`\ngatilho: ${r.trigger} · ${r.cached?"do cache (10 min)":"lido agora"} · ${new Date(r.at).toLocaleString("pt-BR")}`)})'
}

cmd_usage() { # custo por modelo: 7 dias, ou as 24 h de um dia (AAAA-MM-DD, fuso de São Paulo)
  local day="${1:-}"
  [ -z "$day" ] || printf '%s' "$day" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || die "dia inválido: $day (use AAAA-MM-DD)"
  remote "usage${day:+&day=$day}" | node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{const r=JSON.parse(s);if(!r.ok){console.error(r.error);process.exit(1)}
const max=Math.max(...r.chart.bars.map((b)=>b.total),1e-9);
for(const b of r.chart.bars)console.log(`${b.key.padEnd(10)} ${"█".repeat(Math.round(b.total/max*30)).padEnd(30)} US$ ${b.total}`);
console.log(`\n${r.day} por modelo:`);for(const t of r.table)console.log(`  ${t.model.padEnd(45)} ${String(t.req).padStart(5)} req ${String(t.tok).padStart(8)} tok  US$ ${t.cost}`);
const c=r.check;console.log(`\nconferência (dia UTC ${c.dayUtc}): medido US$ ${c.measured} × OpenRouter US$ ${c.informed??"?"}${c.diffPct!==null?` (${c.diffPct}%)`:""} · ${c.nota} · fila: ${r.queue}`)})'
}

cmd_eval() { lock_dev; [ "$TARGET" = dev ] || die "evals rodam só no dev"; node scripts/eval.mjs "$(url)" "$@"; }

cmd_rollback() {
  lock_dev # B4
  local d cur
  d=$(var "DEPLOY_ID_$UP")
  [ -n "$d" ] || die "sem implantação em $TARGET"
  cur=$(clasp_ list-deployments | grep "$d" | grep -oE '@[0-9]+' | tr -d @ | head -1 || true)
  { [ -n "$cur" ] && [ "$cur" -gt 1 ]; } || die "sem versão anterior (atual: ${cur:-?})"
  clasp_ create-deployment -i "$d" -V "$((cur - 1))" -d "rollback" >/dev/null
  ok "$TARGET voltou para a versão $((cur - 1))"
}

case "$CMD" in
  up|down|restart|ship|ci|logs|status|doctor|rollback|open|poc|trace|runs|eval|limits|usage) "cmd_$CMD" "$@" ;;
  *) cat <<'TXT'
gasclaw — agentes do Drive rodando no Google Apps Script

  ./gasclaw up [--prod]       configura (1ª vez), publica e abre a tela
  ./gasclaw down [--prod]     pausa todos os agentes
  ./gasclaw restart [--prod]  down + up
  ./gasclaw ship              publica em prod (mesma URL)
  ./gasclaw logs [--prod]     logs ao vivo
  ./gasclaw status [--prod]   IDs, URLs, implantações e health
  ./gasclaw doctor [--prod]   diagnostica e diz como corrigir
  ./gasclaw rollback [--prod] volta para a versão anterior
  ./gasclaw open [--prod]     abre a tela gasclaw
  ./gasclaw poc <id> [etapa]  roda uma POC no dev e mostra o resultado (ex.: poc p6, poc p10)
  ./gasclaw trace [id]        árvore de passos de um run do agente (sem id: o mais recente)
  ./gasclaw runs              abre a planilha "gasclaw — execuções"
  ./gasclaw limits [--fresh]  painel de limites (Google, OpenRouter e medido pelo gasclaw)
  ./gasclaw usage [AAAA-MM-DD]  custo por modelo: 7 dias, ou as 24 h do dia
  ./gasclaw eval <cenário|--all> [--model id]  roda evals/*.md no dev (exit ≠ 0 em falha)
TXT
  ;;
esac
