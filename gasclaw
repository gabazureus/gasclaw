#!/usr/bin/env bash
# gasclaw — ponto de entrada único e idempotente.  Uso: ./gasclaw <comando> [--prod]
set -euo pipefail
cd "$(dirname "$0")"
# Caminhos onde o SDK do Google costuma cair em cada sistema. Adicionar o que nao existe nao custa nada.
export PATH="$PATH:/usr/local/share/google-cloud-sdk/bin:/opt/homebrew/share/google-cloud-sdk/bin:/usr/lib/google-cloud-sdk/bin:/snap/bin:$HOME/google-cloud-sdk/bin"

# ---------- portabilidade: macOS, Linux, WSL e Git Bash no Windows ----------
#
# O gasclaw era so macOS por tres detalhes, nao por arquitetura: `open`, `pbcopy` e `brew`. Cada um tem
# equivalente nos outros sistemas, e isolar os tres aqui e o que torna o resto do arquivo portatil.
# Windows roda pelo WSL ou pelo Git Bash — o script e bash, e nao ha versao PowerShell.
os_kind() {
  case "${GASCLAW_OS:-$(uname -s 2>/dev/null)}" in
    Darwin|mac)            printf 'mac' ;;
    MINGW*|MSYS*|CYGWIN*|windows) printf 'windows' ;;
    Linux|linux)
      # WSL e Linux para tudo, menos para abrir o navegador: quem abre e o Windows do outro lado.
      if grep -qi microsoft /proc/version 2>/dev/null; then printf 'wsl'; else printf 'linux'; fi ;;
    *) printf 'unknown' ;;
  esac
}

# No Windows o Google Cloud CLI instala como `gcloud.cmd`, e o Git Bash nao resolve `command -v gcloud`:
# era a UNICA dependencia que separava o Git Bash de funcionar. O gasclaw morria com "gcloud not found"
# numa maquina onde o gcloud estava instalado, e o menu mentia no passo 1 — por um sufixo.
#
# Detectar nao basta: quem detecta tem de CHAMAR a forma que existe, dai o `bin_of` devolver o nome.
# `type -P` (e nao `command -v`) porque `command -v` acha FUNCAO do shell: o wrapper `gcloud` abaixo se
# acharia a si mesmo e recorreria para sempre. `type -P` olha so o disco.
bin_of() { # $1 nome da ferramenta -> imprime o nome a invocar; != 0 se nao existe em nenhuma forma
  local c ordem
  # No Windows a forma nativa vem primeiro: MEDIDO numa instalacao real, o `gcloud` POSIX leva 9,7 s contra
  # 2,7 s do `.cmd` — 3,5x mais lento, em TODA chamada. Nos outros sistemas a ordem antiga continua.
  if [ "$(os_kind)" = windows ]; then ordem="$1.cmd $1.exe $1"; else ordem="$1 $1.cmd $1.exe"; fi
  for c in $ordem; do
    if type -P "$c" >/dev/null 2>&1; then printf '%s' "$c"; return 0; fi
  done
  return 1
}
have() { bin_of "$1" >/dev/null 2>&1; }
# Assim o resto do arquivo continua escrevendo `gcloud ...` sem saber de nada disso. `command` pula a
# funcao e vai ao executavel, entao nao ha recursao.
gcloud() { command "$(bin_of gcloud || printf 'gcloud')" "$@"; }

# Abrir uma URL nao pode DERRUBAR o comando: num servidor sem navegador o setup ainda deve seguir, so que
# imprimindo o endereco para a pessoa abrir onde quiser.
open_url() {
  [ -n "${1:-}" ] || return 0
  case "$(os_kind)" in
    mac)     open "$1" >/dev/null 2>&1 || warn "open this yourself: $1" ;;
    linux)   xdg-open "$1" >/dev/null 2>&1 || warn "open this yourself: $1" ;;
    wsl)     { command -v wslview >/dev/null && wslview "$1"; } >/dev/null 2>&1 || cmd.exe //c start "" "$1" >/dev/null 2>&1 || warn "open this yourself: $1" ;;
    windows) start "" "$1" >/dev/null 2>&1 || cmd.exe /c start "" "$1" >/dev/null 2>&1 || warn "open this yourself: $1" ;;
    *)       warn "open this yourself: $1" ;;
  esac
}

# Copia para a area de transferencia; devolve != 0 quando nao ha ferramenta, e quem chama decide o que dizer.
copy_clip() {
  case "$(os_kind)" in
    mac)     pbcopy ;;
    linux|wsl)
      if command -v wl-copy >/dev/null; then wl-copy
      elif command -v xclip >/dev/null; then xclip -selection clipboard
      elif command -v xsel >/dev/null; then xsel --clipboard --input
      elif command -v clip.exe >/dev/null; then clip.exe
      else cat >/dev/null; return 1; fi ;;
    # Mesmo caso do gcloud: no Git Bash quem existe e `clip.exe`, nao `clip`.
    windows) local c; c=$(bin_of clip) || { cat >/dev/null; return 1; }; command "$c" ;;
    *) cat >/dev/null; return 1 ;;
  esac
}

ENV_FILE=gasclaw.env
touch "$ENV_FILE"
set -a
. "./$ENV_FILE"
[ -f .env.local ] && . ./.env.local
set +a

CMD="${1:-}"
[ $# -gt 0 ] && shift
TARGET=dev
for a in "$@"; do [ "$a" = "--prod" ] && TARGET=prod; done
UP=$(printf '%s' "$TARGET" | tr '[:lower:]' '[:upper:]')

# `set -E` + `trap ERR`: sem isto, QUALQUER comando com codigo != 0 fora de um `if`/`||` mata o script em
# silencio, por causa do `set -e` la em cima. Foi assim que a instalacao nova morria no `find` do
# keep_editor_agents — terminal mudo, indistinguivel de "ainda processando", e 10 minutos para descobrir.
# O `ERR` nao dispara em `a || b`, dentro de `if`, nem em comando negado, que e exatamente o que queremos:
# so falha NAO TRATADA fala. `die` usa `exit`, que nao e ERR, entao a mensagem dele nao duplica.
set -E
# `BASH_SUBSHELL`: quando a falha acontece dentro de `$( )`, o ERR dispara no subshell E no pai, e a mensagem
# saia duplicada. So o nivel de cima fala.
trap 'rc=$?; if [ "${BASH_SUBSHELL:-0}" -eq 0 ]; then printf "\033[31m✗ gasclaw stopped unexpectedly near line %s (exit %s). Logs are in .tmp/ — please report this with the lines above.\033[0m\n" "$LINENO" "$rc" >&2; fi' ERR

say()  { printf '\033[1;36m▸ %s\033[0m\n' "$*"; }
ok()   { printf '\033[32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*"; }
die()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
var()  { eval "printf '%s' \"\${$1:-}\""; }
setvar() {
  grep -v "^$1=" "$ENV_FILE" > "$ENV_FILE.tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
  eval "export $1=\"\$2\""
}
pause() { # $1 chave de concluído · $2 URL a abrir (ou vazio) · $3 instrução
  [ -n "$(var "$1")" ] && return 0
  [ -n "${CI:-}" ] && die "manual step pending: $3"
  printf '\n\033[33m⏸  %s\033[0m\n' "$3"
  [ -n "$2" ] && open_url "$2"
  printf '   Press Enter when you are done… '
  read -r _
  setvar "$1" 1
}
LOCK_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/gasclaw"
lock_dev() { # lock POR MÁQUINA (A4): os worktrees usam o mesmo SCRIPT_ID_DEV; reentrante no mesmo shell; liberado no EXIT
  [ -n "${GASCLAW_LOCKED:-}" ] && return 0 # sem export: nenhum processo filho chama o ./gasclaw (os pc.sh são carregados com ".")
  local lock="$LOCK_DIR/dev.lock" waited=0 pid stale
  mkdir -p "$LOCK_DIR"
  until mkdir "$lock" 2>/dev/null; do
    pid=$(cat "$lock/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      stale="$lock.orphan.$$" # B3: mv atômico; se outro processo já pegou o órfão, o mv falha e seguimos esperando
      if mv "$lock" "$stale" 2>/dev/null; then
        warn "stale lock from PID $pid removed"
        rm -rf "$stale"
      fi
      continue
    fi
    [ "$waited" -ge "${GASCLAW_LOCK_TIMEOUT:-1200}" ] && die "dev is busy with PID ${pid:-?} (waited ${waited}s; lock at $lock)"
    [ $((waited % 30)) -eq 0 ] && say "dev is busy with PID ${pid:-?}: waiting for the lock"
    sleep 5
    waited=$((waited + 5))
  done
  printf '%s\n' "$$" > "$lock/pid"
  GASCLAW_LOCKED=1
  trap "rm -rf '$lock'" EXIT # caminho absoluto: vale mesmo se o cwd mudar
}

clasp_() { # projeto privado por chamada: nenhum comando compartilha (nem reescreve) o .clasp.json da raiz
  # O clasp 3.4 recusa rootDir fora da pasta do .clasp.json ("srcDir escapes project root"): o alvo (CLASP_ROOT, padrão
  # dist) é COPIADO para $dir/root antes (o push publica essa cópia congelada) e, num pull, copiado de volta depois.
  local dir target="${CLASP_ROOT:-dist}" rc=0
  mkdir -p .tmp "$target"
  dir=$(mktemp -d "$PWD/.tmp/clasp.XXXXXX")
  mkdir -p "$dir/root"
  cp -R "$target/." "$dir/root/"
  printf '{"scriptId":"%s","rootDir":"root","projectId":"%s"}\n' "$(var "SCRIPT_ID_$UP")" "$(var "GCP_PROJECT_$UP")" > "$dir/.clasp.json"
  (cd "$dir" && npx --no-install clasp "$@") || rc=$?
  if [ "$rc" -eq 0 ] && [ "${1:-}" = pull ]; then cp -R "$dir/root/." "$target/"; fi
  rm -rf "$dir"
  return "$rc"
}
# Conta pessoal (gmail.com) x Google Workspace. Muda TRES coisas: a forma da URL do web app, o publico da
# tela de consentimento, e a existencia do Google Chat. Vale o que estiver gravado em ACCOUNT_KIND; sem isso,
# deduz do dominio do e-mail, que e a mesma regra do `accountKind` no src/limits.ts.
#
# UMA regra, num lugar so. Antes eram duas listas de `case` — uma aqui, outra no `ensure_auth` — e elas
# DIVERGIAM: esta tinha `*@GMAIL.COM`, a de la nao. Um e-mail devolvido com maiuscula pelo gcloud gravava
# ACCOUNT_KIND=workspace numa conta Gmail, e o valor gravado manda; dai toda chamada remota ia para
# `/a/macros/gmail.com/`, que nao existe. Minusculo antes de comparar resolve o caso inteiro.
kind_of_email() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    '') printf 'unknown' ;;
    *@gmail.com|*@googlemail.com) printf 'personal' ;;
    *) printf 'workspace' ;;
  esac
}
account_kind() {
  local k
  k=$(var ACCOUNT_KIND)
  if [ -n "$k" ]; then printf '%s' "$k"; return 0; fi
  kind_of_email "$(var ACCOUNT)"
}
is_personal() { [ "$(account_kind)" = personal ]; }

# Em conta pessoal o Apps Script nao serve o web app sob /a/macros/<dominio>/ — essa forma so existe para
# Workspace. Com DOMAIN=gmail.com a URL antiga apontava para um endereco inexistente e TODA chamada remota
# falhava; era o bloqueador que impedia o gasclaw de rodar fora de Workspace.
# Um lugar so conhece as DUAS formas de URL. As POCs precisam da implantacao @HEAD (`/dev`) e montavam o
# endereco na mao, com `/a/macros/` fixo — ou seja, a P10 recusava conta pessoal mesmo depois do resto passar
# a suportar. Quem precisa de `/dev` chama dev_url; ninguem mais escreve o prefixo a mao.
script_url() { # $1 id da implantacao · $2 exec|dev
  if is_personal; then printf 'https://script.google.com/macros/s/%s/%s' "$1" "$2";
  else printf 'https://script.google.com/a/macros/%s/s/%s/%s' "${DOMAIN:-}" "$1" "$2"; fi
}
exec_url() { script_url "$1" exec; }
dev_url()  { script_url "$1" dev; }
url() { exec_url "$(var "DEPLOY_ID_$UP")"; }
# A tela de conversa servida pelo proprio Apps Script (`?page=chat`). Quem nao tem Google Workspace nao
# fica sem conversar com o agente: o Chat do Google e um canal a mais, nao o unico.
chat_url() { printf '%s?page=chat' "$(url)"; }

# O id do web app tem ~57 caracteres, e gerado pelo Google e nao e configuravel; nao ha encurtador do
# Google desde o fim do goo.gl em 2025, o Apps Script nao aceita dominio proprio, e encurtador de terceiro
# poria um servidor de fora no caminho critico de alcancar o agente (ver ADR-036). Mas a dor nao e o link
# ser longo: e ter de DIGITAR ou MANDAR um link longo. Quem nunca digita nao sofre com o tamanho.
show_link() { # $1 URL · $2 frase curta. Copiar e conveniencia: sem ferramenta de clipboard, so imprime.
  if printf '%s' "$1" | copy_clip 2>/dev/null; then
    ok "$2 (copied to the clipboard): $1"
  else
    ok "$2: $1"
  fi
  return 0
}

sibling_url() { # P21: URL do painel do OUTRO ambiente, embutida no build. Só navegação: nada é lido do outro lado.
  local other d
  if [ "$TARGET" = dev ]; then other=PROD; else other=DEV; fi
  d=$(var "DEPLOY_ID_$other")
  if [ -n "$d" ]; then exec_url "$d"; fi
}
gfetch() { # $1 token · $2 URL · $3 corpo do POST ("" = GET) · $4 segredo (só no POST). Imprime o corpo; ≠ 0 se falhar.
  # Medido (ADR-020): mesmo com o token no salto, o echo do Google perde a resposta de vez em quando (404), sem relação
  # com duração nem concorrência (GET 1/20; POST 0/10 a 3/5 por rodada). GET é idempotente: tenta de novo. POST leva um
  # job aleatório: o servidor executa uma vez por job e guarda o resultado, que a CLI busca por GET se a resposta se perder.
  local t="$1" u="$2" d="$3" s="${4:-}" i r job base t0 unknown_since st
  if [ -z "$d" ]; then
    for i in 1 2 3; do
      if r=$(ghop "$t" "$u" "" ""); then printf '%s' "$r"; return 0; fi
      [ "$i" -lt 3 ] && sleep 2
    done
    return 22
  fi
  job=$(openssl rand -hex 8)
  if r=$(ghop "$t" "$u" "$d&job=$job" "$s"); then printf '%s' "$r"; return 0; fi
  printf 'the POST response was lost inside Google: fetching the result of job %s\n' "$job" >&2
  base="${u%%\?*}"; t0=$(date +%s); unknown_since=$t0
  while [ $(( $(date +%s) - t0 )) -lt 360 ]; do
    sleep 5
    r=$(ghop "$t" "$base?action=job&id=$job" "" "") || continue
    st=$(printf '%s' "$r" | node -e 'let s="";process.stdin.on("data",(d)=>(s+=d)).on("end",()=>{try{const j=JSON.parse(s);if(j.status==="done"){process.stdout.write(JSON.stringify(j.result));process.exit(0)}console.error(j.status||"?");process.exit(3)}catch{process.exit(4)}})' 2>/dev/null) && { printf '%s' "$st"; return 0; }
    if printf '%s' "$r" | grep -q '"status":"unknown"'; then
      [ $(( $(date +%s) - unknown_since )) -ge 60 ] && { printf 'job %s unknown on the server after 60 s: the POST never arrived\n' "$job" >&2; return 22; }
    else
      unknown_since=$(date +%s)
    fi
  done
  printf 'job %s produced no result in 6 min\n' "$job" >&2
  return 22
}

ghop() { # um único pedido ao web app: $1 token · $2 URL · $3 corpo do POST ("" = GET) · $4 segredo. Imprime o corpo; ≠ 0 se não for 200.
  # A resposta vem por 302 para script.googleusercontent.com/…/echo, que EXIGE o token e vale UMA vez; o curl -L não
  # reenvia o Authorization ao trocar de host. Aqui o salto é manual, com o token, e só para o host do echo do Google.
  local t="$1" u="$2" d="$3" s="${4:-}" out meta code loc rc=0
  mkdir -p .tmp
  out=$(mktemp "$PWD/.tmp/resp.XXXXXX")
  if [ -n "$d" ]; then
    meta=$(printf 'header = "Authorization: Bearer %s"\ndata-urlencode = "secret=%s"\n' "$t" "$s" | curl -sS --config - --data "$d" -o "$out" -w '%{http_code} %{redirect_url}' "$u") || rc=$?
  else
    meta=$(printf 'header = "Authorization: Bearer %s"\n' "$t" | curl -sS --config - -o "$out" -w '%{http_code} %{redirect_url}' "$u") || rc=$?
  fi
  code="${meta%% *}"; loc="${meta#* }"; [ "$loc" = "$meta" ] && loc=""
  if [ "$rc" -eq 0 ] && [ "$code" = 302 ] && [ -n "$loc" ]; then
    case "$loc" in
      https://script.googleusercontent.com/*)
        meta=$(printf 'header = "Authorization: Bearer %s"\n' "$t" | curl -sS --config - -o "$out" -w '%{http_code} %{redirect_url}' "$loc") || rc=$?
        code="${meta%% *}" ;;
      *) rc=22; printf 'redirect to an unexpected host refused (the token never leaves Google)\n' >&2 ;;
    esac
  fi
  if [ "$rc" -eq 0 ] && [ "$code" = 200 ]; then cat "$out"; else rc=${rc/#0/22}; printf 'web app answered HTTP %s\n' "${code:-?}" >&2; fi
  rm -f "$out"
  return "$rc"
}

remote_to() { # $1 URL base (…/exec ou …/dev) · $2 "acao&a=b" (já no formato de querystring) · $3 token (opcional, reaproveitado)
  local t="${3:-}" action="${2%%&*}"
  [ -n "$t" ] || t=$(gcloud auth print-access-token 2>/dev/null) || return 1
  # Espelho do MUTATING de src/cli.ts. São duas listas porque o shell não lê o TS; se divergirem, a ação sai por
  # GET e o web app responde 405 — foi o que aconteceu com `tools`. Mexeu lá, mexe aqui.
  case " eval poc enable disable drain step tools capability battery interval budget succeed automate evaluate succession measure lineage " in
    *" $action "*) # M1: ação com efeito → POST; parâmetros no corpo; token e segredo pelo stdin, nunca em argv nem na URL
      # `return 1`, nunca `die`: quem chama guarda com `|| true` e `die` faz `exit`, que `|| true` NAO captura.
      # Com o `2>&1` do chamador engolindo a mensagem, o ./gasclaw up morria mudo aqui e pulava health,
      # aviso de permissoes e a copia da chave do OpenRouter — parecendo que tinha terminado.
      [ -n "${CLI_SECRET:-}" ] || { printf 'no CLI_SECRET in .env.local: run ./gasclaw up (it generates and registers the secret)\n' >&2; return 1; }
      gfetch "$t" "$1" "action=$2" "$CLI_SECRET" ;;
    *) # leitura → GET; token pelo stdin
      gfetch "$t" "$1?action=$2" "" ;;
  esac
}
remote() { remote_to "$(url)" "$1"; }

# A resposta do Apps Script quando falta autorizacao e uma PAGINA HTML, nao um erro: o terminal recebia
# dezenas de linhas de <style> onde devia haver uma frase. Aqui ela vira uma linha que diz o que fazer.
web_error() { # $1 corpo da resposta
  case "$1" in
    '') printf 'no answer from the web app' ;;
    *"Authorization needed"*|*"Autorização necessária"*|*"authorization is required"*) # lang-ok: casa com a pagina que o GOOGLE devolve em pt-BR; nao e saida nossa
      printf 'the web app needs authorization: open %s in the browser, allow access, then run ./gasclaw up again' "$(url)" ;;
    *'<html'*|*'<HTML'*|*'<!DOCTYPE'*|*'<!doctype'*)
      printf 'the web app answered with a web page instead of data (usually a Google sign-in): open %s in the browser and allow access' "$(url)" ;;
    *) printf '%s' "$1" | tr -d '\n' | cut -c1-120 ;;
  esac
}

ensure_cli_secret() { # M1: segredo da CLI gerado no PC (.env.local, gitignored; nunca gasclaw.env) e registrado no web app pelo dono
  local r t
  if [ -z "${CLI_SECRET:-}" ]; then
    CLI_SECRET=$(openssl rand -hex 32)
    touch .env.local
    chmod 600 .env.local
    if [ -s .env.local ] && [ -n "$(tail -c1 .env.local)" ]; then printf '\n' >> .env.local; fi
    printf 'CLI_SECRET=%s\n' "$CLI_SECRET" >> .env.local
    export CLI_SECRET
    ok "CLI secret generated in .env.local"
  fi
  t=$(gcloud auth print-access-token 2>/dev/null || true)
  r=$(gfetch "$t" "$(url)" "action=setsecret" "$CLI_SECRET" 2>/dev/null || true)
  case "$r" in
    *'"ok":true'*) ok "CLI secret registered with the web app" ;;
    *) warn "CLI secret not registered — $(web_error "$r"). Until then, actions with effects (poc, eval, down) will fail" ;;
  esac
}

# Instalar sozinho só no macOS, onde o Homebrew é o padrão de fato. Em Linux há apt, dnf, pacman, zypper e
# snap, cada um com nome de pacote diferente e exigindo privilégio; adivinhar errado mexe na máquina de
# alguém sem permissão. Melhor dizer o comando exato e deixar a pessoa rodar — o resto segue automático.
install_hint() {
  case "$(os_kind)" in
    linux|wsl) printf 'install %s with your package manager (Debian/Ubuntu: %s apt install %s)' "$1" 'sudo' "${2:-$1}" ;;
    windows)   printf 'install %s (winget install %s), then reopen Git Bash' "$1" "${3:-$1}" ;;
    *)         printf 'install %s' "$1" ;;
  esac
}

ensure_tools() {
  if [ "$(os_kind)" = mac ]; then
    have brew || die "Homebrew not found. Install it from https://brew.sh, then run ./gasclaw again — everything else is installed for you."
    have node || brew install node
    have gcloud || brew install --cask google-cloud-sdk
  else
    have node || die "Node.js 20+ not found: $(install_hint 'Node.js' 'nodejs' 'OpenJS.NodeJS.LTS')"
    have gcloud || die "gcloud not found: $(install_hint 'the Google Cloud CLI' 'google-cloud-sdk' 'Google.CloudSDK')"
  fi
  [ -x node_modules/.bin/clasp ] || npm ci
  ok "tools installed"
}

ensure_auth() {
  local acct
  acct=$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null | head -1)
  if [ -z "$acct" ]; then
    say "signing in to Google Cloud (opens the browser)"
    gcloud auth login --enable-gdrive-access
    acct=$(gcloud auth list --filter=status:ACTIVE --format='value(account)' | head -1)
  fi
  # ESTAR LISTADO NAO E ESTAR VALIDO. Uma conta com token expirado continua aparecendo no `auth list`,
  # entao a verificacao acima passa e a falha so estoura MUITO DEPOIS, na primeira chamada real — com a
  # mensagem generica de travamento, sem dizer o que fazer. E a mesma licao que o `pull_into` ja aprendeu
  # para o clasp: perguntar se existe credencial e diferente de perguntar se ela funciona.
  if ! gcloud auth print-access-token >/dev/null 2>&1; then
    die "the Google Cloud credential for $acct expired. Run: gcloud auth login --enable-gdrive-access

This is separate from the clasp credential (~/.clasprc.json): they expire on their own schedules, and
signing in to one does NOT renew the other. Nothing was published."
  fi
  setvar ACCOUNT "$acct"
  setvar DOMAIN "${acct#*@}"
  setvar ACCOUNT_KIND "$(kind_of_email "$acct")"
  if [ ! -f "$HOME/.clasprc.json" ]; then
    say "signing in to clasp (opens the browser)"
    npx --no-install clasp login
  fi
  pause APPS_SCRIPT_API_OK "https://script.google.com/home/usersettings" "Turn on the 'Google Apps Script API'."
  ok "signed in as $ACCOUNT"
}

ensure_gcp() {
  local p
  p=$(var "GCP_PROJECT_$UP")
  if [ -z "$p" ]; then
    p="gasclaw-$TARGET-$(openssl rand -hex 3)"
    say "creating GCP project $p"
    gcloud projects create "$p" --name="gasclaw $TARGET"
    setvar "GCP_PROJECT_$UP" "$p"
  fi
  say "enabling the Google APIs this needs (11 of them; the first time takes 3-5 minutes — it is not stuck)"
  gcloud services enable script.googleapis.com chat.googleapis.com iamcredentials.googleapis.com drive.googleapis.com sheets.googleapis.com logging.googleapis.com monitoring.googleapis.com tasks.googleapis.com people.googleapis.com calendar-json.googleapis.com gmail.googleapis.com --project "$p" >/dev/null
  setvar "GCP_NUMBER_$UP" "$(gcloud projects describe "$p" --format='value(projectNumber)')"
  # `INTERNAL` so existe em Workspace. Numa conta pessoal a unica opcao e EXTERNAL, e voce precisa se
  # adicionar como test user — senao o Google recusa a autorizacao dos escopos.
  if is_personal; then
    pause "CONSENT_OK_$UP" "https://console.cloud.google.com/auth/branding?project=$p" \
      "OAuth consent screen: audience EXTERNAL, app name 'gasclaw', support email $ACCOUNT. Save, then under 'Test users' add $ACCOUNT."
  else
    pause "CONSENT_OK_$UP" "https://console.cloud.google.com/auth/branding?project=$p" \
      "OAuth consent screen: audience INTERNAL, app name 'gasclaw', support email $ACCOUNT. Save."
  fi
  ok "GCP project $p"
}

ensure_chat_identity() { # P2: identidade do app por impersonacao; nenhuma chave e criada ou baixada
  local p sa role policy
  p=$(var "GCP_PROJECT_$UP")
  sa="gasclaw-chat@$p.iam.gserviceaccount.com"
  role="projects/$p/roles/gasclawChatTokenMinter"
  if ! gcloud iam service-accounts describe "$sa" --project "$p" >/dev/null 2>&1; then
    say "creating the Google Chat identity"
    gcloud iam service-accounts create gasclaw-chat --display-name="gasclaw Chat app" --project "$p" >/dev/null
  fi
  if ! gcloud iam roles describe gasclawChatTokenMinter --project "$p" >/dev/null 2>&1; then
    gcloud iam roles create gasclawChatTokenMinter --project "$p" --title="gasclaw Chat token minter" \
      --description="Only mints an ephemeral access token for the Chat app" --permissions=iam.serviceAccounts.getAccessToken --stage=GA >/dev/null
  else
    gcloud iam roles update gasclawChatTokenMinter --project "$p" --title="gasclaw Chat token minter" \
      --description="Only mints an ephemeral access token for the Chat app" --permissions=iam.serviceAccounts.getAccessToken --stage=GA >/dev/null
  fi
  # Conta dedicada: substitui a policy inteira por um unico principal e um unico papel minimo.
  policy=$(mktemp "${TMPDIR:-/tmp}/gasclaw-chat-policy.XXXXXX")
  printf '{"version":1,"bindings":[{"role":"%s","members":["user:%s"]}]}\n' "$role" "$ACCOUNT" > "$policy"
  gcloud iam service-accounts set-iam-policy "$sa" "$policy" --project "$p" --quiet >/dev/null
  rm -f "$policy"
  setvar "CHAT_SA_EMAIL_$UP" "$sa"
  ok "Chat identity, no key: $sa"
}

ensure_script() {
  if [ -z "$(var "SCRIPT_ID_$UP")" ]; then
    rm -f .clasp.json
    mkdir -p dist
    npx --no-install clasp create-script --type standalone --title "gasclaw-$TARGET" --rootDir dist
    setvar "SCRIPT_ID_$UP" "$(node -p 'require("./.clasp.json").scriptId')"
  fi
  pause "GCP_LINKED_$UP" "https://script.google.com/home/projects/$(var "SCRIPT_ID_$UP")/settings" \
    "Project Settings → Google Cloud Platform (GCP) Project → Change project → paste the number $(var "GCP_NUMBER_$UP") → Set project."
  ok "script $(var "SCRIPT_ID_$UP")"
}

# Credencial expirada nao e falha passageira, e repetir nao renova nada. O clasp devolve `invalid_grant` /
# `invalid_rapt` quando o Workspace exige reautenticacao periodica para escopos sensiveis; antes disto o
# gasclaw tentava tres vezes, esperava 3 s entre elas, e terminava sem dizer o que fazer.
#
# A confusao que isso causa e especifica e cara: o cofre do clasp (~/.clasprc.json) e SEPARADO do cofre do
# gcloud. Quem acabou de rodar `gcloud auth login` acha que ja resolveu, e o erro se repete igual.
auth_expirada() {
  case "$1" in
    *invalid_grant*|*invalid_rapt*|*Unauthorized*|*'status code 401'*) return 0 ;;
    *) return 1 ;;
  esac
}

pull_into() { # $1 pasta; falha de rede e passageira e merece 3 tentativas — credencial expirada, nenhuma
  local i saida
  for i in 1 2 3; do
    saida=$(CLASP_ROOT="$1" clasp_ pull 2>&1) && return 0
    if auth_expirada "$saida"; then
      printf '%s\n' "$saida" >&2
      die "the clasp credential expired. Run: npx clasp login

This is separate from gcloud: \`gcloud auth login\` does NOT renew it, and they expire on their own schedules.
Nothing was published, so edits made in the Apps Script editor are untouched."
    fi
    warn "clasp pull failed (attempt $i of 3)"
    [ "$i" -lt 3 ] && sleep 3
  done
  printf '%s\n' "$saida" >&2
  die "clasp pull failed 3 times: not publishing, so edits made in the editor are not erased"
}

keep_editor_agents() { # ADR-013: o push --force troca o HEAD inteiro; antes, traz os arquivos agentes/** editados no editor
  local r=.tmp/remote n
  rm -rf "$r" dist/agentes
  mkdir -p "$r"
  pull_into "$r"
  if [ -d "$r/agentes" ]; then cp -R "$r/agentes" dist/; fi
  # Numa instalacao NOVA o script remoto nao tem `agentes/`, entao `dist/agentes` nao existe e o `find` sai
  # != 0. Com `pipefail` o pipe inteiro vira != 0 e o `set -e` matava o `./gasclaw up` AQUI, sem imprimir
  # nada: o log parava em "build (right before the push)" e nada era publicado. O `2>/dev/null` escondia a
  # mensagem do find, mas nao o codigo de saida — quem silencia o erro tem de tratar o codigo.
  n=$( { find dist/agentes -type f 2>/dev/null || true; } | wc -l | tr -d ' ')
  ok "editor files preserved: $n"
}

deploy() {
  lock_dev
  mkdir -p .tmp
  say "tests"
  npm test > .tmp/test.log 2>&1 || die "tests failed: see .tmp/test.log" # o build.test gera numa pasta temporária
  say "build (right before the push)"
  export GCP_NUMBER="$(var "GCP_NUMBER_$UP")" # Monitoring (ADR-016)
  export CHAT_SA_EMAIL="$(var "CHAT_SA_EMAIL_$UP")" # P2: email publico da identidade, nunca credencial
  if [ "$TARGET" = dev ]; then export GASCLAW_DEV=1; else export GASCLAW_DEV=0; fi # POCs só no build do dev (M1)
  export GASCLAW_ENV="$TARGET"          # P21: rótulo do ambiente no cabeçalho do painel
  export SIBLING_URL="$(sibling_url)"   # P21: link para o painel irmão (vazio enquanto o outro não tiver implantação)
  OUT_DIR=dist npm run build > .tmp/build.log 2>&1 || die "build failed: see .tmp/build.log"
  local built
  built=$(shasum -a 256 dist/_motor.js dist/appsscript.json | cut -d' ' -f1 | tr '\n' ' ')
  keep_editor_agents # depois do build: o build.mjs apaga o dist/ inteiro, e os agentes/** do editor precisam ir junto
  check_bundle "$built"
  say "push ($TARGET)"
  clasp_ push --force >/dev/null
  verify_head
  publish
}

same_as_build() { # $1 pasta baixada → "" se o motor, as telas e o manifesto (escopos ordenados + webapp + chat) batem com o dist/
  # A lista SAI do dist/, nao e escrita a mao: era `_motor.js settings.html chat.html` enquanto o build ja
  # emitia hub.html tambem, entao o gate imprimia "identicos ao build" sem ter conferido uma das telas.
  local f bad="" lista
  lista=$(cd dist && ls *.js *.html 2>/dev/null)
  # Lista vazia faria o gate passar por vacuo — que e a propria falha que ele existe para pegar.
  [ -n "$lista" ] || { printf '%s' " dist-vazio"; return 0; }
  for f in $lista; do
    cmp -s "$1/$f" "dist/$f" || bad="$bad $f"
  done
  node -e 'const k=(p)=>{const m=JSON.parse(require("fs").readFileSync(p,"utf8"));return JSON.stringify([[...(m.oauthScopes||[])].sort(),m.webapp,m.chat])};process.exit(k(process.argv[1])===k("dist/appsscript.json")?0:1)' "$1/appsscript.json" 2>/dev/null || bad="$bad appsscript.json"
  printf '%s' "$bad"
}

verify_head() { # depois do push e antes da versão: o HEAD remoto (pull isolado) é exatamente o build
  local dir=".tmp/verify-$$" bad
  mkdir -p "$dir"
  pull_into "$dir"
  bad=$(same_as_build "$dir")
  rm -rf "$dir" # B2
  [ -z "$bad" ] || die "remote HEAD differs from the build after the push (${bad# }): not creating the version"
  ok "remote HEAD verified: engine, screens and manifest identical to the build ($(node -p 'JSON.parse(require("fs").readFileSync("dist/appsscript.json","utf8")).oauthScopes.length') scopes)"
}

verify_version() { # A5: a VERSÃO criada (imutável) é o build, antes de apontar a implantação para ela
  local v="$1" dir=".tmp/version-$1-$$" bad
  mkdir -p "$dir"
  CLASP_ROOT="$dir" clasp_ pull --versionNumber "$v" >/dev/null || { rm -rf "$dir"; die "could not download version $v: deployment NOT pointed at it"; }
  bad=$(same_as_build "$dir")
  rm -rf "$dir"
  [ -z "$bad" ] || die "version $v differs from the build (${bad# }): deployment NOT pointed at it"
  ok "version $v verified: identical to the build"
}

check_bundle() { # $1 sha do build. A v18 saiu com o bundle da v17 porque o dist/ foi regravado entre o build e o push
  local n missing=""
  for n in $(grep -oE '^export function [A-Za-z0-9_]+' src/main.ts | awk '{print $3}'); do
    grep -q "^function $n(" dist/_motor.js || missing="$missing $n"
  done
  [ -z "$missing" ] || die "bundle out of date: missing from dist/_motor.js:$missing"
  [ "$(shasum -a 256 dist/_motor.js dist/appsscript.json | cut -d' ' -f1 | tr '\n' ' ')" = "$1" ] || die "dist/ changed between the build and the push (npm test, build or clasp running in parallel?): not publishing"
  # Conta os INVOLUCROS que o build realmente emitiu, nao um regex proprio sobre o main.ts: essa era a terceira
  # copia da mesma regra (build.mjs e o proprio main.ts sao as outras) e ja divergia — dizia 39 para 41.
  ok "bundle verified: $(grep -c '^function .*return gasclaw\.' dist/_motor.js) global functions, $(wc -c < dist/_motor.js | tr -d ' ') bytes"
}

version_label() { # SHA do commit, com -dirty se src/ ou o manifesto têm mudança não commitada
  local sha dirty=""
  sha=$(git rev-parse --short HEAD 2>/dev/null || echo local)
  [ -z "$(git status --porcelain -- src appsscript.json build.mjs 2>/dev/null)" ] || dirty="-dirty"
  printf 'gasclaw %s%s' "$sha" "$dirty"
}

publish() { # versão nova do HEAD + implantação fixa apontando para ela (mesma URL)
  local out v d
  out=$(clasp_ create-version "$(version_label)")
  v=$(printf '%s' "$out" | grep -oE 'ersion [0-9]+' | grep -oE '[0-9]+' | head -1 || true) # M19: sem || true, o pipefail matava o script calado
  [ -n "$v" ] || die "could not read the version number: $out"
  verify_version "$v"
  d=$(var "DEPLOY_ID_$UP")
  if [ -z "$d" ]; then
    out=$(clasp_ create-deployment -V "$v" -d "gasclaw $TARGET")
    d=$(printf '%s' "$out" | grep -oE 'AKfy[A-Za-z0-9_-]+' | head -1 || true)
    [ -n "$d" ] || die "could not read the deployment id: $out"
    setvar "DEPLOY_ID_$UP" "$d"
  else
    clasp_ create-deployment -i "$d" -V "$v" -d "gasclaw $TARGET" >/dev/null
  fi
  ok "$TARGET on version $v → $(url)"
}

authorize() {
  local label="gasclaw"
  [ "$TARGET" = dev ] && label="gasclaw dev"
  pause "WEBAPP_AUTH_$UP" "$(url)" "In the tab that just opened, choose your account and click Allow (first authorization)."
  pause "CHAT_OK_$UP" "https://console.cloud.google.com/apis/api/chat.googleapis.com/hangouts-chat?project=$(var "GCP_PROJECT_$UP")" \
    "Chat API → Configuration: App name '$label'; avatar https://fonts.gstatic.com/s/e/notoemoji/latest/1f980/512.png; description 'Agents that live in your Drive'; UNCHECK 'Build this Chat app as a Google Workspace add-on'; Functionality: receive 1:1 messages and join spaces; Connection settings: Apps Script project → Deployment ID $(var "DEPLOY_ID_$UP"); Visibility: specific people in $DOMAIN (or the whole domain); Save."
}

health() {
  local r
  r=$(remote health 2>/dev/null || true)
  case "$r" in
    *'"ok":true'*)
      # Grava o que o menu do onboarding precisa saber, para ele nao ter que perguntar pela rede (A6).
      case "$r" in *'"agents":0'*) ;; *'"agents":'*) setvar "AGENT_OK_$UP" 1 ;; esac
      ok "health: $r" ;;
    *) warn "health not confirmed automatically (open $(url)). Response: ${r:0:160}" ;;
  esac
}

cmd_up() {
  lock_dev
  ensure_tools
  ensure_auth
  ensure_gcp
  [ "$TARGET" = dev ] && ensure_chat_identity
  ensure_script
  deploy
  ensure_cli_secret # ADR-022 (a): logo depois do deploy, antes de qualquer outra chamada ao web app
  authorize
  remote enable >/dev/null 2>&1 || true
  health
  # Uma leitura so, usada para as duas conferencias.
  local limits
  limits=$(remote "limits&fresh=1" 2>/dev/null || true)
  # O gatilho de 1 min e o worker: sem ele o agente e instalado e NUNCA responde. `up` dizia "pronto" do mesmo
  # jeito, porque nada aqui olhava para isso.
  case "$limits" in
    *'"trigger":"active"'*) ok "1-minute worker active" ;;
    '') warn "could not check the 1-minute worker (open the gasclaw panel once: it creates the trigger)" ;;
    *) warn "the 1-minute worker is NOT active: agents will never answer. Open $(url) — the panel creates the trigger when it loads" ;;
  esac
  # consentimento granular: escopo sem autorização vira exceção capturada, e o Google não pede sozinho
  if printf '%s' "$limits" | grep -q '"status":"pending"'; then
    warn "missing Google permissions: open https://script.google.com/home/projects/$(var "SCRIPT_ID_$UP")/edit → file _motor.gs → pick \"authorize\" in the function menu → ▶ Run → Allow (or use \"Authorize permissions\" at the top of the panel)"
  fi
  if [ -n "${OPENROUTER_API_KEY:-}" ]; then
    # Conveniência, não requisito: sem ferramenta de clipboard no sistema, o setup segue e a pessoa pega a
    # chave no .env.local. A chave nunca é impressa na tela.
    if printf '%s' "$OPENROUTER_API_KEY" | copy_clip 2>/dev/null; then
      # segurança baixa: a chave sai do clipboard em 90 s (só no macOS, onde dá para conferir o que está lá)
      [ "$(os_kind)" = mac ] && (sleep 90; [ "$(pbpaste 2>/dev/null)" = "$OPENROUTER_API_KEY" ] && printf '' | pbcopy) >/dev/null 2>&1 &
      say "OpenRouter key copied to the clipboard — paste it into 'OpenRouter key' on the panel (first time only)"
    else
      say "paste your OpenRouter key into 'OpenRouter key' on the panel (it is in .env.local; first time only)"
    fi
  else
    warn "no OPENROUTER_API_KEY in .env.local — paste the key straight into the panel"
  fi
  open_url "$(url)"
  ok "ready ($TARGET): $(url)"
  # Sem copiar: a chave do OpenRouter pode ter acabado de ir para o clipboard, e ela e mais urgente aqui.
  ok "talk to your agent: $(chat_url)"
}

cmd_down()    { remote disable && echo && ok "agents paused ($TARGET)"; }
cmd_restart() { cmd_down || true; cmd_up; }
cmd_open() { # sem argumento abre o painel; `--chat` vai direto para a conversa com o agente
  local alvo
  alvo=$(url)
  for a in "$@"; do [ "$a" = "--chat" ] && alvo=$(chat_url); done
  open_url "$alvo"
}

