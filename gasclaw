TXT
}

case "$CMD" in
  up|down|restart|ship|ci|logs|status|doctor|rollback|open|poc|trace|runs|eval|limits|usage|tools|swarm|onboard) "cmd_$CMD" "$@" ;;
  # Sem argumento: quem ainda nao publicou nao quer uma lista de 15 comandos, quer saber por onde comecar.
  # Quem ja publicou ja sabe, e a lista e mais util. O `help` explicito sempre mostra a lista.
  '') if [ -n "$(var "DEPLOY_ID_$UP")" ]; then cmd_help; else cmd_onboard; fi ;;
  *) cmd_help ;;
esac
