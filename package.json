{
  "name": "gasclaw",
  "description": "AI agents that run 100% on Google Apps Script: each agent is a Google Drive folder of markdown, you talk to it in Google Chat, and the model comes from OpenRouter.",
  "keywords": [
    "google-apps-script",
    "ai-agents",
    "llm",
    "openrouter",
    "google-chat",
    "google-drive",
    "google-workspace",
    "clasp",
    "typescript",
    "serverless"
  ],
  "author": "Gabriel Sorrentino <gabriel.br@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "vitest run",
    "up": "./gasclaw up",
    "ship": "./gasclaw ship"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@types/google-apps-script": "2.0.13",
    "@types/node": "24.13.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
